class extends="testbox.system.BaseSpec" {

    function run() {
        describe( "MVM CLI", function() {
            it( "lists released MatchBox versions available for this platform", function() {
                var result = systemExecute(
                    name=getsystemsetting( "MVM_BIN", "" ),
                    arguments=[ "list-remote" ],
                    timeout=45
                );
                var output = result.output & result.error;

                expect( result.exitCode ).toBe( 0 );
                expect( output ).toInclude( "Available MatchBox versions" );
                expect( reFindNoCase( "[0-9]+[.][0-9]+[.][0-9]+", output ) ).toBeGT( 0 );
            } );

            it( "defaults to .mvm under the user's home directory", function() {
                var home = getTempDirectory() & "/mvm-default-home-" & createUUID();
                directoryCreate( home );
                var result = systemExecute(
                    name=getsystemsetting( "MVM_BIN", "" ),
                    arguments=[ "list" ],
                    timeout=30,
                    inheritEnvironment=false,
                    environment={ HOME: home, USERPROFILE: home }
                );

                expect( result.exitCode ).toBe( 0 );
                expect( directoryExists( home & "/.mvm/versions" ) ).toBeTrue();
                directoryDelete( home, true );
            } );

            it( "shows help when run without a command", function() {
                var result = systemExecute(
                    name=getsystemsetting( "MVM_BIN", "" ),
                    arguments=[],
                    timeout=30
                );
                var output = result.output & result.error;

                expect( output ).toInclude( "MatchBox Version Manager" );
                expect( output ).toInclude( "install <version>" );
                expect( output ).toInclude( "tui" );
            } );

            it( "prints the MVM application version", function() {
                var result = systemExecute(
                    name=getsystemsetting( "MVM_BIN", "" ),
                    arguments=[ "version" ],
                    timeout=30
                );

                expect( result.output & result.error ).toInclude( "MVM version: 0.1.0" );
            } );

            it( "stores a project version in .mvmrc", function() {
                var workingDir = getsystemsetting( "MVM_HOME", "" ) & "/test-project";
                directoryCreate( workingDir );
                var result = systemExecute(
                    name=getsystemsetting( "MVM_BIN", "" ),
                    arguments=[ "local", "0.10.1" ],
                    directory=workingDir,
                    timeout=30
                );

                expect( result.exitCode ).toBe( 0 );
                expect( fileRead( workingDir & "/.mvmrc" ).trim() ).toBe( "0.10.1" );
            } );

            it( "rejects activating a version that is not installed", function() {
                var result = systemExecute(
                    name=getsystemsetting( "MVM_BIN", "" ),
                    arguments=[ "use", "99.99.99" ],
                    timeout=30
                );

                expect( result.exitCode ).toBe( 1 );
                expect( result.output & result.error ).toInclude( "not installed" );
            } );

            it( "reports when no MatchBox version is active", function() {
                var result = systemExecute(
                    name=getsystemsetting( "MVM_BIN", "" ),
                    arguments=[ "current" ],
                    timeout=30
                );

                expect( result.output & result.error ).toInclude( "No MatchBox version is active" );
            } );

            it( "reports an empty install when MVM_HOME has no versions", function() {
                var home = getsystemsetting( "MVM_HOME", "" );
                var binary = getsystemsetting( "MVM_BIN", "" );

                expect( len( home ) ).toBeGT( 0 );
                expect( len( binary ) ).toBeGT( 0 );

                var result = systemExecute(
                    name=binary,
                    arguments=[ "list" ],
                    timeout=30
                );

                expect( result.output & result.error ).toInclude( "No MatchBox versions installed" );
                expect( directoryExists( home & "/versions" ) ).toBeTrue();
            } );
        } );
    }
}
