class extends="testbox.system.BaseSpec" {

    variables.mvmHome = "";

    function run() {
        describe( "MVM CLI", function() {
            beforeEach( function() {
                variables.mvmHome = getTempDirectory() & "/mvm-" & createUUID();
                directoryCreate( variables.mvmHome );
            } );

            afterEach( function() {
                if ( directoryExists( variables.mvmHome ) ) directoryDelete( variables.mvmHome, true );
            } );

            it( "lists released MatchBox versions available for this platform", function() {
                var result = runMvm( [ "list-remote" ] );
                var output = result.output & result.error;

                expect( result.exitCode ).toBe( 0 );
                expect( output ).toInclude( "Available MatchBox versions" );
                expect( reFindNoCase( "[0-9]+[.][0-9]+[.][0-9]+", output ) ).toBeGT( 0 );
            } );

            it( "installs the latest MatchBox release", function() {
                var result = runMvm( [ "install", "latest" ] );
                var installed = runMvm( [ "list" ] );

                expect( result.exitCode ).toBe( 0 );
                expect( result.output & result.error ).toInclude( "installed" );
                expect( installed.output ).notToInclude( "No MatchBox versions installed" );
                expect( reFindNoCase( "[0-9]+[.][0-9]+[.][0-9]+", installed.output ) ).toBeGT( 0 );
            } );

            it( "activates the local version and executes MatchBox", function() {
                expect( runMvm( [ "install", "latest" ] ).exitCode ).toBe( 0 );
                var installed = runMvm( [ "list" ] );
                var versions = reMatchNoCase( "[0-9]+[.][0-9]+[.][0-9]+", installed.output );
                expect( arrayLen( versions ) ).toBeGT( 0 );

                var workingDir = variables.mvmHome & "/project";
                directoryCreate( workingDir );
                runMvm( [ "local", "latest" ], workingDir );
                var use = runMvm( [ "use" ], workingDir );
                var current = runMvm( [ "current" ] );
                var list = runMvm( [ "list" ] );
                var execution = runMvm( [ "exec", "--version" ] );
                var removed = runMvm( [ "remove", versions[ 1 ] ] );
                var currentAfterRemove = runMvm( [ "current" ] );
                var listAfterRemove = runMvm( [ "list" ] );

                expect( use.exitCode ).toBe( 0 );
                expect( use.output ).toInclude( "Now using MatchBox " & versions[ 1 ] );
                expect( current.output ).toInclude( versions[ 1 ] );
                expect( list.output ).toInclude( "(current)" );
                expect( execution.exitCode ).toBe( 0 );
                expect( execution.output & execution.error ).toInclude( versions[ 1 ] );
                expect( removed.output & removed.error ).toInclude( "removed" );
                expect( currentAfterRemove.output ).toInclude( "No MatchBox version is active" );
                expect( listAfterRemove.output ).toInclude( "No MatchBox versions installed" );
            } );

            it( "reports when TUI is requested without an interactive terminal", function() {
                var result = runMvm( [ "tui" ] );
                expect( result.output & result.error ).toInclude( "interactive terminal" );
            } );

            it( "defaults to .mvm under the user's home directory", function() {
                var home = getTempDirectory() & "/mvm-default-home-" & createUUID();
                directoryCreate( home );
                var result = systemExecute(
                    name=getsystemsetting( "MVM_BIN", "" ),
                    arguments=[ "list" ],
                    timeout=30,
                    inheritEnvironment=false,
                    environment={ HOME: home, USERPROFILE: home }
                );

                expect( result.exitCode ).toBe( 0 );
                expect( directoryExists( home & "/.mvm/versions" ) ).toBeTrue();
                directoryDelete( home, true );
            } );

            it( "shows help when run without a command", function() {
                var result = runMvm( [] );
                var output = result.output & result.error;

                expect( output ).toInclude( "MatchBox Version Manager" );
                expect( output ).toInclude( "install <version>" );
                expect( output ).toInclude( "tui" );
            } );

            it( "rejects unknown commands", function() {
                var result = runMvm( [ "not-a-command" ] );

                expect( result.exitCode ).toBe( 1 );
                expect( result.output & result.error ).toInclude( "Unknown command" );
            } );

            it( "prints the MVM application version", function() {
                var result = runMvm( [ "version" ] );
                expect( result.output & result.error ).toInclude( "MVM version: 0.1.0" );
            } );

            it( "stores a project version in .mvmrc", function() {
                var workingDir = variables.mvmHome & "/project";
                directoryCreate( workingDir );
                var result = runMvm( [ "local", "0.10.1" ], workingDir );

                expect( result.exitCode ).toBe( 0 );
                expect( fileRead( workingDir & "/.mvmrc" ).trim() ).toBe( "0.10.1" );
            } );

            it( "rejects activating a version that is not installed", function() {
                var result = runMvm( [ "use", "99.99.99" ] );

                expect( result.exitCode ).toBe( 1 );
                expect( result.output & result.error ).toInclude( "not installed" );
            } );

            it( "reports when no MatchBox version is active", function() {
                var result = runMvm( [ "current" ] );
                expect( result.output & result.error ).toInclude( "No MatchBox version is active" );
            } );

            it( "reports an empty install when MVM_HOME has no versions", function() {
                var result = runMvm( [ "list" ] );

                expect( result.output & result.error ).toInclude( "No MatchBox versions installed" );
                expect( directoryExists( variables.mvmHome & "/versions" ) ).toBeTrue();
            } );
        } );
    }

    private function runMvm( required array args, string workingDir="" ) {
        var options = {
            name: getsystemsetting( "MVM_BIN", "" ),
            arguments: args,
            timeout: 180,
            environment: { MVM_HOME: variables.mvmHome }
        };
        if ( len( workingDir ) ) options.directory = workingDir;
        return systemExecute( argumentCollection=options );
    }
}
