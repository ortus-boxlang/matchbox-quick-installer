class extends="testbox.system.BaseSpec" {

    variables.mvmHome = "";

    function run() {
        describe( "MVM CLI", function() {
            beforeEach( function() {
                variables.mvmHome = getTempDirectory() & "/mvm-" & createUUID();
                directoryCreate( variables.mvmHome );
            } );

            afterEach( function() {
                if ( directoryExists( variables.mvmHome ) ) directoryDelete( variables.mvmHome, true );
            } );

            it( "lists released MatchBox versions available for this platform", function() {
                var result = runMvm( [ "list-remote" ] );
                var output = result.output & result.error;

                expect( result.exitCode ).toBe( 0 );
                expect( output ).toInclude( "Available MatchBox versions" );
                expect( reFindNoCase( "[0-9]+[.][0-9]+[.][0-9]+", output ) ).toBeGT( 0 );
            } );

            it( "installs the latest MatchBox release", function() {
                var result = runMvm( [ "install", "latest" ] );
                var installed = runMvm( [ "list" ] );
                var versions = reMatchNoCase( "[0-9]+[.][0-9]+[.][0-9]+", installed.output );
                var exactInstall = runMvm( [ "install", versions[ 1 ] ] );

                expect( result.exitCode ).toBe( 0 );
                expect( result.output & result.error ).toInclude( "installed" );
                expect( installed.output ).notToInclude( "No MatchBox versions installed" );
                expect( arrayLen( versions ) ).toBeGT( 0 );
                expect( exactInstall.output & exactInstall.error ).toInclude( "already installed" );
            } );

            it( "updates the MVM executable from the latest channel release", function() {
                var binDirectory = variables.mvmHome & "/bin";
                var mvmBinary = binDirectory & "/mvm";
                directoryCreate( binDirectory );
                fileWrite( mvmBinary, "old MVM binary" );

                var update = runMvm( [ "update" ] );
                var installed = systemExecute( name=mvmBinary, arguments=[ "version" ], timeout=30 );
                var versions = reMatchNoCase( "[0-9]+[.][0-9]+[.][0-9]+", update.output & update.error );

                expect( update.exitCode ).toBe( 0 );
                expect( update.output & update.error ).toInclude( "Updated MVM to " );
                expect( arrayLen( versions ) ).toBeGT( 0 );
                expect( installed.exitCode ).toBe( 0 );
                expect( installed.output & installed.error ).toInclude( "MVM version: " & versions[ 1 ] );
            } );

            it( "prints a valid Bash completion script", function() {
                var result = runMvm( [ "completion", "bash" ] );
                var completionFile = variables.mvmHome & "/mvm-completion.bash";
                directoryCreate( variables.mvmHome & "/versions/0.9.0" );
                fileWrite( completionFile, result.output );
                var syntax = systemExecute( name="bash", arguments=[ "-n", completionFile ], timeout=10 );
                var shellCommand = 'source "$1"; COMP_WORDS=(mvm use 0.); COMP_CWORD=2; _mvm_completions; echo "${COMPREPLY[*]}"';
                var completion = systemExecute(
                    name="bash",
                    arguments=[ "--noprofile", "--norc", "-c", shellCommand, "bash", completionFile ],
                    timeout=10,
                    environment={ MVM_HOME: variables.mvmHome }
                );

                expect( result.exitCode ).toBe( 0 );
                expect( result.output ).toInclude( "install update use local" );
                expect( result.output ).toInclude( "--force" );
                expect( result.output ).toInclude( "--fix" );
                expect( syntax.exitCode ).toBe( 0 );
                expect( completion.output ).toInclude( "0.9.0" );
            } );

            it( "installs and registers Bash completions", function() {
                if ( getsystemsetting( "OS", "" ).lCase().contains( "windows" ) ) return;

                var userHome = variables.mvmHome & "/user";
                var fakeBin = variables.mvmHome & "/fake-bin";
                var mvmHome = userHome & "/custom-mvm";
                var requestedVersion = "2.3.4-snapshot";
                var curlLog = userHome & "/curl.log";
                var curlScript = fakeBin & "/curl";
                var unameScript = fakeBin & "/uname";
                var newline = createObject( "java", "java.lang.System" ).lineSeparator();
                directoryCreate( userHome );
                directoryCreate( fakeBin );
                fileWrite( curlScript,
                    "##!/bin/sh" & newline &
                    "echo $2 > $MVM_CURL_LOG" & newline &
                    "while [ $## -gt 0 ]; do" & newline &
                    "  if [ $1 = -o ]; then shift; output=$1; fi" & newline &
                    "  shift" & newline &
                    "done" & newline &
                    "cp $MVM_BIN $output" & newline
                );
                fileWrite( unameScript,
                    "##!/bin/sh" & newline &
                    "case $1 in -s) echo ${MVM_TEST_OS:-Linux} ;; -m) echo x86_64 ;; esac" & newline
                );
                var chmod = systemExecute( name="chmod", arguments=[ "+x", curlScript ], timeout=10 );
                var chmodUname = systemExecute( name="chmod", arguments=[ "+x", unameScript ], timeout=10 );
                var installOptions = {
                    name: "bash",
                    arguments: [ "install/install.sh" ],
                    timeout: 30,
                    environment: {
                        HOME: userHome,
                        MVM_HOME: mvmHome,
                        MVM_BIN: getsystemsetting( "MVM_BIN", "" ),
                        MVM_CURL_LOG: curlLog,
                        MVM_VERSION: requestedVersion,
                        SHELL: "/bin/bash",
                        PATH: fakeBin & ":" & getsystemsetting( "PATH", "" )
                    }
                };
                var installer = systemExecute( argumentCollection=installOptions );
                var repeatedInstall = systemExecute( argumentCollection=installOptions );
                var completionFile = mvmHome & "/completions/mvm.bash";
                var profile = fileRead( userHome & "/.bashrc" );
                var completionMarkers = reMatchNoCase( "MVM bash completion", profile );
                var macUserHome = variables.mvmHome & "/mac-user";
                var macMvmHome = macUserHome & "/custom-mvm";
                directoryCreate( macUserHome );
                var macInstallOptions = {
                    name: "bash",
                    arguments: [ "install/install.sh" ],
                    timeout: 30,
                    environment: {
                        HOME: macUserHome,
                        MVM_HOME: macMvmHome,
                        MVM_BIN: getsystemsetting( "MVM_BIN", "" ),
                        MVM_CURL_LOG: macUserHome & "/curl.log",
                        MVM_VERSION: requestedVersion,
                        MVM_TEST_OS: "Darwin",
                        SHELL: "/bin/bash",
                        PATH: fakeBin & ":" & getsystemsetting( "PATH", "" )
                    }
                };
                var macInstaller = systemExecute( argumentCollection=macInstallOptions );
                var macRepeatInstall = systemExecute( argumentCollection=macInstallOptions );
                var bashProfile = fileRead( macUserHome & "/.bash_profile" );
                var macBashrc = fileRead( macUserHome & "/.bashrc" );
                var macCompletionMarkers = reMatchNoCase( "MVM bash completion", macBashrc );
                var loginShell = systemExecute(
                    name="bash",
                    arguments=[ "--login", "-c", "echo $MVM_HOME" ],
                    timeout=10,
                    environment={ HOME: macUserHome, MVM_HOME: "/ignored", PATH: getsystemsetting( "PATH", "" ) }
                );

                expect( chmod.exitCode ).toBe( 0 );
                expect( chmodUname.exitCode ).toBe( 0 );
                expect( installer.exitCode ).toBe( 0 );
                expect( repeatedInstall.exitCode ).toBe( 0 );
                expect( fileExists( completionFile ) ).toBeTrue();
                expect( fileRead( completionFile ) ).toInclude( "complete -o default -F _mvm_completions mvm" );
                expect( fileRead( curlLog ) ).toInclude( "/releases/download/v" & requestedVersion & "/mvm-linux-x64" );
                expect( arrayLen( completionMarkers ) ).toBe( 1 );
                expect( macInstaller.exitCode ).toBe( 0 );
                expect( macRepeatInstall.exitCode ).toBe( 0 );
                expect( bashProfile ).toInclude( "MVM Bash login bridge" );
                expect( bashProfile ).toInclude( ".bashrc" );
                expect( arrayLen( macCompletionMarkers ) ).toBe( 1 );
                expect( loginShell.output ).toInclude( "/custom-mvm" );
            } );

            it( "repairs Bash completions when doctor is asked to fix them", function() {
                if ( getsystemsetting( "OS", "" ).lCase().contains( "windows" ) ) return;

                var userHome = variables.mvmHome & "/doctor-user";
                var mvmHome = userHome & "/custom-mvm";
                var fakeBin = userHome & "/fake-bin";
                var newline = createObject( "java", "java.lang.System" ).lineSeparator();
                directoryCreate( userHome );
                directoryCreate( fakeBin );
                var unameScript = fakeBin & "/uname";
                fileWrite( unameScript, "##!/bin/sh" & newline & "case $1 in -s) echo ${MVM_TEST_OS:-Linux} ;; -m) echo x86_64 ;; esac" & newline );
                var chmod = systemExecute( name="chmod", arguments=[ "+x", unameScript ], timeout=10 );
                var options = {
                    name: getsystemsetting( "MVM_BIN", "" ),
                    arguments: [ "doctor" ],
                    timeout: 30,
                    environment: {
                        HOME: userHome,
                        MVM_HOME: mvmHome,
                        SHELL: "/bin/bash",
                        PATH: fakeBin & ":" & mvmHome & "/bin:" & getsystemsetting( "PATH", "" )
                    }
                };
                var diagnostic = systemExecute( argumentCollection=options );
                var completionFile = mvmHome & "/completions/mvm.bash";
                var profilePath = userHome & "/.bashrc";
                var initiallyMissing = !fileExists( completionFile );
                var profileUntouched = !fileExists( profilePath );
                options.arguments = [ "doctor", "--fix" ];
                var fixed = systemExecute( argumentCollection=options );
                fileWrite( completionFile, "stale completion" );
                options.arguments = [ "doctor" ];
                var staleDiagnostic = systemExecute( argumentCollection=options );
                var stalePreserved = fileRead( completionFile ) == "stale completion";
                options.arguments = [ "doctor", "--fix" ];
                var repeatedFix = systemExecute( argumentCollection=options );
                options.environment[ "MVM_TEST_OS" ] = "Darwin";
                var macFix = systemExecute( argumentCollection=options );
                var bashProfile = fileRead( userHome & "/.bash_profile" );
                directoryCreate( mvmHome & "/versions/0.9.0" );
                var loginCompletion = systemExecute(
                    name="bash",
                    arguments=[ "--login", "-c", 'COMP_WORDS=(mvm use 0.); COMP_CWORD=2; _mvm_completions; echo "${COMPREPLY[*]}"' ],
                    timeout: 10,
                    environment={ HOME: userHome, MVM_HOME: mvmHome, PATH: getsystemsetting( "PATH", "" ) }
                );
                var profile = fileExists( profilePath ) ? fileRead( profilePath ) : "";
                var completionMarkers = reMatchNoCase( "MVM bash completion", profile );

                expect( chmod.exitCode ).toBe( 0 );
                expect( diagnostic.exitCode ).toBe( 0 );
                expect( diagnostic.output & diagnostic.error ).toInclude( "Run 'mvm doctor --fix'" );
                expect( initiallyMissing ).toBeTrue();
                expect( profileUntouched ).toBeTrue();
                expect( fixed.exitCode ).toBe( 0 );
                expect( fixed.output & fixed.error ).toInclude( "Bash completions" );
                expect( staleDiagnostic.output & staleDiagnostic.error ).toInclude( "missing or stale" );
                expect( stalePreserved ).toBeTrue();
                expect( repeatedFix.exitCode ).toBe( 0 );
                expect( fileExists( completionFile ) ).toBeTrue();
                expect( fileRead( completionFile ) ).toInclude( "_mvm_completions" );
                expect( arrayLen( completionMarkers ) ).toBe( 1 );
                expect( macFix.exitCode ).toBe( 0 );
                expect( bashProfile ).toInclude( "MVM Bash login bridge" );
                expect( loginCompletion.output ).toInclude( "0.9.0" );
            } );

            it( "asks before updating MVM on interactive startup", function() {
                if ( getsystemsetting( "OS", "" ).lCase().contains( "windows" ) ) return;

                var binDirectory = variables.mvmHome & "/bin";
                var mvmBinary = binDirectory & "/mvm";
                var newline = createObject( "java", "java.lang.System" ).lineSeparator();
                directoryCreate( binDirectory );
                fileWrite( mvmBinary, "##!/bin/sh" & newline & "echo 'MVM version: 0.0.0'" & newline );
                fileWrite( variables.mvmHome & "/update-check", "checked" );
                var chmod = systemExecute( name="chmod", arguments=[ "+x", mvmBinary ], timeout=10 );
                var startup = {
                    name: "/bin/sh",
                    arguments: [ "-c", "echo n | script -qec '$MVM_BIN current' /dev/null" ],
                    timeout: 30,
                    environment: {
                        MVM_HOME: variables.mvmHome,
                        MVM_BIN: getsystemsetting( "MVM_BIN", "" ),
                        PATH: getsystemsetting( "PATH", "" )
                    }
                };
                var completionStartup = {
                    name: "/bin/sh",
                    arguments: [ "-c", "script -qec '$MVM_BIN completion bash' /dev/null" ],
                    timeout: 30,
                    environment: startup.environment
                };
                var completionResult = systemExecute( argumentCollection=completionStartup );
                var result = systemExecute( argumentCollection=startup );
                var secondResult = systemExecute( argumentCollection=startup );

                expect( chmod.exitCode ).toBe( 0 );
                expect( completionResult.exitCode ).toBe( 0 );
                expect( completionResult.output & completionResult.error ).toInclude( "_mvm_completions" );
                expect( completionResult.output & completionResult.error ).notToInclude( "Update now? [y/N]" );
                expect( result.exitCode ).toBe( 0 );
                expect( result.output & result.error ).toInclude( "Update now? [y/N]" );
                expect( secondResult.exitCode ).toBe( 0 );
                expect( secondResult.output & secondResult.error ).notToInclude( "Update now? [y/N]" );
            } );

            it( "activates the local version and executes MatchBox", function() {
                expect( runMvm( [ "install", "latest" ] ).exitCode ).toBe( 0 );
                var installed = runMvm( [ "list" ] );
                var versions = reMatchNoCase( "[0-9]+[.][0-9]+[.][0-9]+", installed.output );
                expect( arrayLen( versions ) ).toBeGT( 0 );

                var workingDir = variables.mvmHome & "/project";
                directoryCreate( workingDir );
                runMvm( [ "local", "latest" ], workingDir );
                var use = runMvm( [ "use" ], workingDir );
                var current = runMvm( [ "current" ] );
                var list = runMvm( [ "list" ] );
                var execution = runMvm( [ "exec", "--version" ] );
                var windowsPlatform = getsystemsetting( "OS", "" ).lCase().contains( "windows" );
                var matchbox = windowsPlatform
                    ? systemExecute( name="cmd", arguments=[ "/c", "matchbox --version" ], timeout=30 )
                    : systemExecute(
                        name="/bin/sh",
                        arguments=[ "-c", 'PATH="' & variables.mvmHome & '/bin:$PATH" matchbox --version' ],
                        timeout=30
                    );
                var doctor = runMvm( [ "doctor" ] );
                var removed = runMvm( [ "remove", versions[ 1 ] ] );
                var currentAfterRemove = runMvm( [ "current" ] );
                var listAfterRemove = runMvm( [ "list" ] );

                expect( use.exitCode ).toBe( 0 );
                expect( use.output ).toInclude( "Now using MatchBox " & versions[ 1 ] );
                expect( current.output ).toInclude( versions[ 1 ] );
                expect( list.output ).toInclude( "(current)" );
                expect( execution.exitCode ).toBe( 0 );
                expect( execution.output & execution.error ).toInclude( versions[ 1 ] );
                expect( matchbox.exitCode ).toBe( 0 );
                expect( matchbox.output & matchbox.error ).toInclude( versions[ 1 ] );
                expect( doctor.exitCode ).toBe( 0 );
                expect( doctor.output & doctor.error ).toInclude( "Active MatchBox: " & versions[ 1 ] );
                expect( removed.output & removed.error ).toInclude( "removed" );
                expect( currentAfterRemove.output ).toInclude( "No MatchBox version is active" );
                expect( listAfterRemove.output ).toInclude( "No MatchBox versions installed" );
            } );

            it( "reports when TUI is requested without an interactive terminal", function() {
                var result = runMvm( [ "tui" ] );
                expect( result.output & result.error ).toInclude( "interactive terminal" );
            } );

            it( "defaults to .mvm under the user's home directory", function() {
                var home = getTempDirectory() & "/mvm-default-home-" & createUUID();
                directoryCreate( home );
                var result = systemExecute(
                    name=getsystemsetting( "MVM_BIN", "" ),
                    arguments=[ "list" ],
                    timeout=30,
                    inheritEnvironment=false,
                    environment={ HOME: home, USERPROFILE: home }
                );

                expect( result.exitCode ).toBe( 0 );
                expect( directoryExists( home & "/.mvm/versions" ) ).toBeTrue();
                directoryDelete( home, true );
            } );

            it( "shows help when run without a command", function() {
                var result = runMvm( [] );
                var output = result.output & result.error;

                expect( output ).toInclude( "MatchBox Version Manager" );
                expect( output ).toInclude( "install <version>" );
                expect( output ).toInclude( "tui" );
            } );

            it( "rejects unknown commands", function() {
                var result = runMvm( [ "not-a-command" ] );

                expect( result.exitCode ).toBe( 1 );
                expect( result.output & result.error ).toInclude( "Unknown command" );
            } );

            it( "prints the MVM version, commit, and build date", function() {
                var result = runMvm( [ "version" ] );
                var output = result.output & result.error;
                expect( reFindNoCase( "MVM version: [0-9]+[.][0-9]+[.][0-9]+(-[A-Za-z0-9.-]+)?", output ) ).toBeGT( 0 );
                expect( reFindNoCase( "Commit: [0-9a-f]{7,40}", output ) ).toBeGT( 0 );
                expect( reFindNoCase( "Built on: [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", output ) ).toBeGT( 0 );
            } );

            it( "stores a project version in .mvmrc", function() {
                var workingDir = variables.mvmHome & "/project";
                directoryCreate( workingDir );
                var result = runMvm( [ "local", "0.10.1" ], workingDir );

                expect( result.exitCode ).toBe( 0 );
                expect( fileRead( workingDir & "/.mvmrc" ).trim() ).toBe( "0.10.1" );
            } );

            it( "rejects activating a version that is not installed", function() {
                var result = runMvm( [ "use", "99.99.99" ] );

                expect( result.exitCode ).toBe( 1 );
                expect( result.output & result.error ).toInclude( "not installed" );
            } );

            it( "reports when no MatchBox version is active", function() {
                var result = runMvm( [ "current" ] );
                var doctor = runMvm( [ "doctor" ] );
                expect( result.output & result.error ).toInclude( "No MatchBox version is active" );
                expect( doctor.exitCode ).toBe( 0 );
                expect( doctor.output & doctor.error ).toInclude( "No MatchBox version is active" );
            } );

            it( "cleans cached files without removing installed versions", function() {
                var versionDir = variables.mvmHome & "/versions/0.10.2";
                var cachedFile = variables.mvmHome & "/cache/download.partial";
                directoryCreate( variables.mvmHome & "/cache" );
                directoryCreate( versionDir & "/bin" );
                fileWrite( variables.mvmHome & "/current", "0.10.2" );
                fileWrite( cachedFile, "partial download" );

                var result = runMvm( [ "clean" ] );

                expect( result.exitCode ).toBe( 0 );
                expect( result.output & result.error ).toInclude( "cache cleared" );
                expect( fileExists( cachedFile ) ).toBeFalse();
                expect( directoryExists( versionDir ) ).toBeTrue();
                expect( fileExists( variables.mvmHome & "/current" ) ).toBeTrue();
            } );

            it( "reports an empty install when MVM_HOME has no versions", function() {
                var result = runMvm( [ "list" ] );

                expect( result.output & result.error ).toInclude( "No MatchBox versions installed" );
                expect( directoryExists( variables.mvmHome & "/versions" ) ).toBeTrue();
            } );
        } );
    }

    private function runMvm( required array args, string workingDir="" ) {
        var options = {
            name: getsystemsetting( "MVM_BIN", "" ),
            arguments: args,
            timeout: 180,
            environment: {
                MVM_HOME: variables.mvmHome,
                PATH: variables.mvmHome & "/bin" & ( getsystemsetting( "OS", "" ).lCase().contains( "windows" ) ? ";" : ":" ) & getsystemsetting( "PATH", "" )
            }
        };
        if ( len( workingDir ) ) options.directory = workingDir;
        return systemExecute( argumentCollection=options );
    }
}
