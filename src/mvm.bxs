MVM_VERSION = "2.0.1-snapshot";
MVM_COMMIT = "unknown";
MVM_BUILT_ON = "unknown";
MVM_HOME = getsystemsetting( "MVM_HOME", getsystemsetting( "HOME", getsystemsetting( "USERPROFILE", "~" ) ) & "/.mvm" );
MATCHBOX_HOME = getsystemsetting( "MATCHBOX_HOME", "" );
if ( !len( MATCHBOX_HOME ) ) MATCHBOX_HOME = getsystemsetting( "HOME", getsystemsetting( "USERPROFILE", "~" ) ) & "/.matchbox";
MVM_VERSIONS = MVM_HOME & "/versions";
MVM_CACHE = MVM_HOME & "/cache";
MVM_CURRENT = MVM_HOME & "/current";
MATCHBOX_GITHUB_API = "https://api.github.com/repos/ortus-boxlang/matchbox";
MVM_GITHUB_API = "https://api.github.com/repos/ortus-boxlang/matchbox-quick-installer";
MVM_UPDATE_CHECK = MVM_HOME & "/update-check";
MVM_COMMANDS = "install update use local current doctor clean list ls list-remote remove uninstall exec run tui version completion help";
MVM_COMPLETION_SHELLS = "bash,zsh,fish";

if ( !directoryExists( MVM_HOME ) ) directoryCreate( MVM_HOME );
if ( !directoryExists( MVM_VERSIONS ) ) directoryCreate( MVM_VERSIONS );
if ( !directoryExists( MVM_CACHE ) ) directoryCreate( MVM_CACHE );

/**
 * Perform a GitHub API request and decode the JSON response, using GITHUB_TOKEN/GH_TOKEN when available.
 *
 * @param url URL to request or download.
 * @param failFast Whether to exit immediately on failure.
 * @param timeout Timeout in seconds.
 *
 * @return Decoded GitHub response.
 */
function githubJson( url, failFast=true, timeout=30 ) {
    var response = {};
    var headers = { "User-Agent": "MVM" };
    var githubToken = getsystemsetting( "GITHUB_TOKEN", getsystemsetting( "GH_TOKEN", "" ) );
    if ( len( trim( githubToken ) ) ) headers[ "Authorization" ] = "Bearer " & githubToken;
    try {
        response = jsonDeserialize( http({
            url: url,
            headers: headers,
            timeout: timeout
        }).get() );
    } catch ( any e ) {
        if ( !failFast ) return {};
        println( "Could not contact GitHub: " & e.message );
        cliexit( 1 );
    }
    if ( response.status != 200 ) {
        if ( !failFast ) return {};
        println( "GitHub request failed with HTTP " & response.status );
        cliexit( 1 );
    }
    try {
        return jsonDeserialize( response.body );
    } catch ( any e ) {
        if ( !failFast ) return {};
        println( "Invalid GitHub response: " & e.message );
        cliexit( 1 );
    }
}

/**
 * Detect whether MVM is running on Windows.
 *
 * @return True on Windows.
 */
function isWindows() {
    return getsystemsetting( "OS", "" ).lCase() contains "windows";
}

/**
 * Build the release asset name for the current OS and architecture.
 *
 * @param prefix Asset name prefix.
 *
 * @return Platform asset name.
 */
function getPlatformAssetName( prefix="matchbox" ) {
    var windows = isWindows();
    var os = "";
    if ( windows ) {
        os = "windows";
    } else {
        var osResult = systemExecute( "uname", [ "-s" ], 10 );
        var osName = trim( osResult.output ).lCase();
        if ( osName contains "linux" ) os = "linux";
        if ( osName contains "darwin" ) os = "macos";
        if ( !len( os ) ) {
            println( "Unsupported operating system: " & osName );
            cliexit( 1 );
        }
    }

    var arch = windows
        ? getsystemsetting( "PROCESSOR_ARCHITECTURE", "x64" ).lCase()
        : trim( systemExecute( "uname", [ "-m" ], 10 ).output ).lCase();
    if ( arch == "x86_64" || arch == "amd64" || arch == "x64" ) arch = "x64";
    else if ( arch == "aarch64" || arch == "arm64" ) arch = "arm64";
    else if ( arch == "i386" || arch == "i686" || arch == "x86" ) arch = "x86";
    else if ( arch.startsWith( "armv7" ) ) arch = "armv7";
    else {
        println( "Unsupported architecture: " & arch );
        cliexit( 1 );
    }
    return prefix & "-" & os & "-" & arch & ( windows ? ".exe" : "" );
}

/**
 * Normalize a version tag by trimming whitespace and a leading v.
 *
 * @param version Version string.
 *
 * @return Normalized version.
 */
function normalizeVersion( version ) {
    version = trim( version );
    return version.startsWith( "v" ) ? listLast( version, "v" ) : version;
}

/**
 * Fetch all MatchBox releases with version metadata.
 *
 * @return Release array.
 */
function getRemoteReleases() {
    var releases = githubJson( MATCHBOX_GITHUB_API & "/releases?per_page=100" );
    var assetName = getPlatformAssetName();
    var available = [];
    for ( release in releases ) {
        if ( !isValidVersion( normalizeVersion( release.tag_name ) ) ) continue;
        if ( len( findReleaseAsset( release, assetName ) ) ) {
            if ( release.tag_name == "snapshot" ) release.matchboxMetadata = getReleaseMetadata( release );
            arrayAppend( available, release );
        }
    }
    return available;
}

/**
 * Print the available MatchBox releases.
 *
 * @return Nothing.
 */
function listRemoteVersions() {
    var releases = getRemoteReleases();
    println( "Available MatchBox versions:" );
    var latestShown = false;
    for ( release in releases ) {
        var version = normalizeVersion( release.tag_name );
        var suffix = release.prerelease ? " (pre-release)" : ( !latestShown ? " (latest)" : "" );
        println( "  " & versionLabel( version, release.matchboxMetadata ?: {} ) & suffix );
        if ( !release.prerelease ) latestShown = true;
    }
}

/**
 * Validate that a version tag is safe to use as a directory name.
 *
 * @param version Version string.
 *
 * @return True when valid.
 */
function isValidVersion( version ) {
    return reFind( "^[A-Za-z0-9][A-Za-z0-9.+_-]*$", version ) == 1;
}

/**
 * Compare two semantic version strings.
 *
 * @param left Left version to compare.
 * @param right Right version to compare.
 *
 * @return 1, -1, or 0.
 */
function compareVersions( left, right ) {
    var leftParts = listToArray( listFirst( left, "-" ), "." );
    var rightParts = listToArray( listFirst( right, "-" ), "." );
    for ( var i = 1; i <= 3; i++ ) {
        var leftPart = i <= arrayLen( leftParts ) ? val( leftParts[ i ] ) : 0;
        var rightPart = i <= arrayLen( rightParts ) ? val( rightParts[ i ] ) : 0;
        if ( leftPart > rightPart ) return 1;
        if ( leftPart < rightPart ) return -1;
    }
    var leftPrerelease = find( "-", left ) > 0;
    var rightPrerelease = find( "-", right ) > 0;
    if ( leftPrerelease && !rightPrerelease ) return -1;
    if ( !leftPrerelease && rightPrerelease ) return 1;
    return 0;
}

/**
 * Read the installed MVM version from a binary.
 *
 * @param binaryPath Path to the MVM binary.
 *
 * @return Version string or empty.
 */
function getInstalledMvmVersion( binaryPath ) {
    if ( !fileExists( binaryPath ) ) return "";
    try {
        var result = systemExecute( binaryPath, [ "version" ], 10 );
        var versions = reMatchNoCase( "[0-9]+[.][0-9]+[.][0-9]+(-[A-Za-z0-9.-]+)?", result.output & result.error );
        return result.exitCode == 0 && arrayLen( versions ) ? versions[ 1 ] : "";
    } catch ( any e ) {
        return "";
    }
}

/**
 * Read the installed MVM commit from a binary.
 *
 * @param binaryPath Path to the MVM binary.
 *
 * @return Commit hash or empty.
 */
function getInstalledMvmCommit( binaryPath ) {
    if ( !fileExists( binaryPath ) ) return "";
    try {
        var result = systemExecute( binaryPath, [ "version" ], 10 );
        var commits = reMatchNoCase( "Commit: [0-9a-f]{7,40}", result.output & result.error );
        return result.exitCode == 0 && arrayLen( commits ) ? listLast( commits[ 1 ], " " ).lCase() : "";
    } catch ( any e ) {
        return "";
    }
}

/**
 * Extract the source commit from MVM release metadata.
 *
 * @param release GitHub release struct.
 *
 * @return Commit hash or empty.
 */
function getMvmReleaseCommit( release ) {
    var commits = reMatchNoCase( "Commit: [0-9a-f]{7,40}", release.body ?: "" );
    return arrayLen( commits ) ? listLast( commits[ 1 ], " " ).lCase() : "";
}

/**
 * Fetch the latest MVM GitHub release.
 *
 * @param failFast Whether to exit immediately on failure.
 *
 * @return Release struct.
 */
function getLatestMvmRelease( failFast=true ) {
    if ( right( MVM_VERSION, 9 ) == "-snapshot" ) {
        var releases = githubJson( MVM_GITHUB_API & "/releases?per_page=100", false, failFast ? 30 : 5 );
        var latestSnapshot = {};
        if ( isArray( releases ) ) {
            for ( release in releases ) {
                var candidate = normalizeVersion( release.tag_name ?: "" );
                if ( !release.prerelease || right( candidate, 9 ) != "-snapshot" || !isValidVersion( candidate ) ) continue;
                if ( !latestSnapshot.keyExists( "tag_name" ) || compareVersions( candidate, normalizeVersion( latestSnapshot.tag_name ) ) > 0 ) latestSnapshot = release;
            }
        }
        if ( latestSnapshot.keyExists( "tag_name" ) ) return latestSnapshot;
    }
    return githubJson( MVM_GITHUB_API & "/releases/latest", failFast, failFast ? 30 : 5 );
}

/**
 * Resolve GitHub release information for a requested MatchBox version.
 *
 * @param version Version string.
 *
 * @return Release struct.
 */
function getReleaseInfo( version ) {
    version = normalizeVersion( version );
    if ( !isValidVersion( version ) ) {
        println( "Invalid MatchBox version: " & version );
        cliexit( 1 );
    }
    var tag = version == "latest" ? "latest" : ( version == "snapshot" ? "snapshot" : "v" & version );
    var endpoint = tag == "latest" ? "/latest" : "/tags/" & tag;
    var release = githubJson( MATCHBOX_GITHUB_API & "/releases" & endpoint );
    release.matchboxMetadata = getReleaseMetadata( release );
    return release;
}

/**
 * Download and decode a MatchBox release version.json file.
 *
 * @param release GitHub release struct.
 *
 * @return Metadata struct.
 */
function getReleaseMetadata( release ) {
    var url = findReleaseAsset( release, "version.json" );
    if ( !len( url ) ) {
        println( "MatchBox " & release.tag_name & " has no version.json; a verified installation is unavailable." );
        cliexit( 1 );
    }
    var metadata = githubJson( url );
    if ( !isStruct( metadata ) || !isValidVersion( metadata.version ?: "" ) ||
        reFind( "^[0-9]+$", metadata.build_id ?: "" ) != 1 ||
        ( metadata.build_version ?: "" ) != ( metadata.version & "+" & metadata.build_id ) ||
        reFind( "^[0-9a-f]{40}$", metadata.revision ?: "" ) != 1 ||
        ( metadata.tag ?: "" ) != release.tag_name || !isArray( metadata.artifacts ?: "" ) ||
        ( release.tag_name == "snapshot" ? right( metadata.version, 9 ) != "-snapshot" : metadata.version != normalizeVersion( release.tag_name ) ) ) {
        println( "Invalid MatchBox release metadata." );
        cliexit( 1 );
    }
    return metadata;
}

/**
 * Read version.json metadata for an installed version.
 *
 * @param version Version string.
 *
 * @return Metadata struct.
 */
function getInstalledMetadata( version ) {
    var path = MVM_VERSIONS & "/" & version & "/version.json";
    return fileExists( path ) ? jsonDeserialize( fileRead( path ) ) : {};
}

/**
 * Compare installed and published snapshot build metadata.
 *
 * @param installed Installed metadata struct.
 * @param published Published metadata struct.
 *
 * @return True when builds match.
 */
function sameBuild( installed, published ) {
    return ( installed.build_version ?: "" ) == published.build_version && ( installed.revision ?: "" ) == published.revision;
}

/**
 * Build a human-readable MatchBox version label.
 *
 * @param version Version string.
 * @param metadata Release metadata struct.
 *
 * @return Display label.
 */
function versionLabel( version, metadata={} ) {
    return metadata.keyExists( "build_version" )
        ? version & " [" & metadata.build_version & ", " & left( metadata.revision, 7 ) & "]"
        : version;
}

/**
 * Find a release asset URL by file name.
 *
 * @param release GitHub release struct.
 * @param assetName Release asset file name.
 *
 * @return Asset URL or empty.
 */
function findReleaseAsset( release, assetName ) {
    for ( asset in release.assets ) {
        if ( asset.name == assetName ) return asset.browser_download_url;
    }
    return "";
}

/**
 * Render a single terminal download progress frame.
 *
 * @param label Display label.
 * @param downloaded Number of bytes downloaded.
 * @param total Total expected bytes.
 * @param percent Download percentage.
 *
 * @return Nothing.
 */
function renderDownloadProgress( label, downloaded, total, percent ) {
    var width = 25;
    var filled = total > 0 ? int( percent * width / 100 ) : 0;
    var bar = repeatString( "█", filled ) & repeatString( "░", width - filled );
    var suffix = total > 0 ? right( "  " & percent, 3 ) & "%" : right( "          " & val( downloaded ), 10 ) & " B";
    writeOutput( char( 13 ) & "  " & label & " [" & bar & "] " & suffix );
}

/**
 * Quote a path for POSIX shell command lines.
 *
 * @param path Filesystem path.
 *
 * @return Single-quoted shell path.
 */
function shellQuotePath( path ) {
    return char( 39 ) & replace( path, char( 39 ), char( 39 ) & char( 92 ) & char( 39 ) & char( 39 ), "all" ) & char( 39 );
}

/**
 * Quote a path for Windows cmd.exe command lines.
 *
 * @param path Filesystem path.
 *
 * @return Double-quoted Windows path.
 */
function windowsQuotePath( path ) {
    return char( 34 ) & replace( path, char( 34 ), char( 34 ) & char( 34 ), "all" ) & char( 34 );
}

/**
 * Download a MatchBox release asset, with a progress bar on interactive terminals.
 *
 * @param url URL to request or download.
 * @param path Filesystem path.
 * @param label Display label.
 * @param totalBytes Expected asset size from release metadata.
 *
 * @return HTTP response struct.
 */
function downloadMatchBoxAsset( url, path, label, totalBytes ) {
    if ( !cliIsTerminal() || totalBytes <= 0 ) {
        return http({
            url: url,
            path: path,
            timeout: 180
        }).get();
    }

    var chunkFiles = [];
    var chunkSize = 4 * 1024 * 1024;
    var downloaded = 0;
    try {
        while ( downloaded < totalBytes ) {
            var start = downloaded;
            var end = min( downloaded + chunkSize - 1, totalBytes - 1 );
            var chunkPath = path & ".part-" & arrayLen( chunkFiles ) + 1;
            var raw = http({
                url: url,
                headers: { "Range": "bytes=" & start & "-" & end },
                path: chunkPath,
                timeout: 180
            }).get();
            var response = isStruct( raw ) ? raw : jsonDeserialize( raw );
            if ( response.status != 206 && response.status != 200 ) {
                throw( message="Range download failed with HTTP " & ( response.status ?: "unknown" ) );
            }
            var chunkSizeOnDisk = fileInfo( chunkPath ).size;
            if ( !chunkSizeOnDisk ) break;
            arrayAppend( chunkFiles, chunkPath );
            downloaded += chunkSizeOnDisk;
            renderDownloadProgress( label, downloaded, totalBytes, min( 100, int( downloaded * 100 / totalBytes ) ) );
        }

        if ( arrayLen( chunkFiles ) == 1 ) {
            fileMove( chunkFiles[ 1 ], path );
        } else {
            var concatenation = "";
            if ( isWindows() ) {
                for ( var chunkFile in chunkFiles ) concatenation &= windowsQuotePath( chunkFile ) & "+";
                concatenation = left( concatenation, len( concatenation ) - 1 ) & " " & windowsQuotePath( path ) & " >nul";
                systemExecute( "cmd", [ "/c", "copy /b " & concatenation ], 60 );
            } else {
                for ( var chunkFile in chunkFiles ) concatenation &= shellQuotePath( chunkFile ) & " ";
                concatenation = "cat " & trim( concatenation ) & " > " & shellQuotePath( path );
                systemExecute( "sh", [ "-c", concatenation ], 60 );
            }
            for ( var chunkFile in chunkFiles ) fileDelete( chunkFile );
        }
        if ( downloaded < totalBytes ) renderDownloadProgress( label, downloaded, totalBytes, 100 );
        writeOutput( char( 13 ) & repeatString( " ", 90 ) & char( 13 ) );
        return { status: 200 };
    } finally {
        for ( var chunkFile in chunkFiles ) if ( fileExists( chunkFile ) ) fileDelete( chunkFile );
    }
}

/**
 * Find the published size of a release asset.
 *
 * @param release GitHub release struct.
 * @param assetName Release asset file name.
 *
 * @return Asset size in bytes, or zero when unavailable.
 */
function findReleaseAssetSize( release, assetName ) {
    for ( asset in release.assets ) {
        if ( asset.name == assetName ) return val( asset.size ?: 0 );
    }
    return 0;
}

/**
 * Compute the SHA-256 checksum of a downloaded file.
 *
 * @param path Filesystem path.
 * @param assetName Release asset file name.
 *
 * @return Lowercase checksum.
 */
function downloadChecksum( path, assetName ) {
    var result = {};
    if ( isWindows() ) {
        var command = "(Get-FileHash -LiteralPath '" & replace( path, "'", "''", "all" ) & "' -Algorithm SHA256).Hash";
        result = systemExecute( "powershell.exe", [ "-NoProfile", "-NonInteractive", "-Command", command ], 30 );
    } else if ( assetName contains "-macos-" ) {
        result = systemExecute( "shasum", [ "-a", "256", "--", path ], 30 );
    } else {
        result = systemExecute( "sha256sum", [ "--", path ], 30 );
    }
    if ( result.exitCode != 0 ) throw( message="SHA-256 command failed: " & result.error );
    // SHA tools can prefix escaped filenames with a backslash.
    return left( replace( trim( result.output ), char( 92 ), "", "one" ), 64 ).lCase();
}

/**
 * Download, verify, stage, and activate a MatchBox version.
 *
 * @param requestedVersion User-requested version.
 * @param force Whether to reinstall an existing version.
 *
 * @return Installed version.
 */
function installVersion( requestedVersion, force=false ) {
    var release = getReleaseInfo( len( trim( requestedVersion ) ) ? requestedVersion : "latest" );
    var version = normalizeVersion( release.tag_name );
    if ( !isValidVersion( version ) ) {
        println( "GitHub returned an invalid MatchBox version: " & version );
        cliexit( 1 );
    }
    var metadata = release.matchboxMetadata;
    var label = versionLabel( version, metadata );
    var versionDir = MVM_VERSIONS & "/" & version;
    if ( directoryExists( versionDir ) && !force ) {
        var installed = getInstalledMetadata( version );
        if ( version != "snapshot" || sameBuild( installed, metadata ) ) {
            println( "MatchBox " & label & " is already installed. Use --force to reinstall." );
            return version;
        }
    }

    var assetName = getPlatformAssetName();
    var checksum = "";
    var checksumMatches = 0;
    for ( artifact in metadata.artifacts ) {
        if ( artifact.file == assetName ) {
            checksumMatches++;
            checksum = artifact.sha256 ?: "";
        }
    }
    if ( checksumMatches != 1 || reFindNoCase( "^[0-9a-f]{64}$", checksum ) != 1 ) {
        println( "Missing or invalid SHA-256 checksum for " & assetName );
        cliexit( 1 );
    }
    var assetUrl = findReleaseAsset( release, assetName );
    if ( !len( assetUrl ) ) {
        println( "No " & assetName & " asset exists for MatchBox " & version );
        cliexit( 1 );
    }
    var assetSize = findReleaseAssetSize( release, assetName );

    var downloadPath = MVM_CACHE & "/matchbox-" & version & "-" & createUUID() & ".download";
    println( "Downloading MatchBox " & label & "..." );
    var response = {};
    try {
        response = jsonDeserialize( downloadMatchBoxAsset( assetUrl, downloadPath, "Downloading MatchBox " & label, assetSize ) );
    } catch ( any e ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        println( "failed." );
        println( e.message );
        cliexit( 1 );
    }
    if ( response.status != 200 || !fileExists( downloadPath ) || fileInfo( downloadPath ).size == 0 ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        println( "failed (HTTP " & response.status & ")." );
        cliexit( 1 );
    }

    try {
        if ( downloadChecksum( downloadPath, assetName ) != checksum.lCase() ) {
            throw( message="SHA-256 checksum mismatch for " & assetName );
        }
    } catch ( any e ) {
        fileDelete( downloadPath );
        println( "Could not verify MatchBox download: " & e.message );
        cliexit( 1 );
    }

    var stageDir = MVM_VERSIONS & "/.mvm-stage-" & createUUID();
    var backupDir = MVM_VERSIONS & "/.mvm-backup-" & createUUID();
    var binaryName = isWindows() ? "matchbox.exe" : "matchbox";
    var stageBinary = stageDir & "/bin/" & binaryName;
    directoryCreate( stageDir & "/bin" );
    fileWrite( stageDir & "/version.json", jsonSerialize( metadata ) );
    fileMove( downloadPath, stageBinary );
    if ( !isWindows() ) fileSetExecutable( stageBinary );

    var hadVersion = directoryExists( versionDir );
    if ( hadVersion ) directoryMove( versionDir, backupDir );
    try {
        directoryMove( stageDir, versionDir );
    } catch ( any e ) {
        if ( hadVersion ) directoryMove( backupDir, versionDir );
        if ( directoryExists( stageDir ) ) directoryDelete( stageDir, true );
        println( "Could not install MatchBox " & version & ": " & e.message );
        cliexit( 1 );
    }
    if ( hadVersion ) directoryDelete( backupDir, true );
    println( "MatchBox " & label & " installed." );
    return version;
}

/**
 * Read the active MatchBox version marker.
 *
 * @return Active version or empty.
 */
function getCurrentVersion() {
    if ( !fileExists( MVM_CURRENT ) ) return "";
    var version = normalizeVersion( trim( fileRead( MVM_CURRENT ) ) );
    return isValidVersion( version ) ? version : "";
}

/**
 * Create the platform-specific matchbox launcher shim.
 *
 * @return Nothing.
 */
function createMatchboxShim() {
    var binDirectory = MVM_HOME & "/bin";
    if ( !directoryExists( binDirectory ) ) directoryCreate( binDirectory );

    if ( isWindows() ) {
        fileWrite(
            binDirectory & "/matchbox.cmd",
            "@echo off" & char( 13 ) & char( 10 ) &
            "set /p MVM_VERSION=<" & char( 34 ) & "%~dp0..\current" & char( 34 ) & char( 13 ) & char( 10 ) &
            char( 34 ) & "%~dp0..\versions\%MVM_VERSION%\bin\matchbox.exe" & char( 34 ) & " %*" & char( 13 ) & char( 10 )
        );
        return;
    }

    fileWrite(
        binDirectory & "/matchbox",
        '##!/bin/sh' & char( 10 ) &
        'MVM_HOME=$(cd "$(dirname "$0")/.." && pwd)' & char( 10 ) &
        'VERSION=$(cat "$MVM_HOME/current") || exit 1' & char( 10 ) &
        'exec "$MVM_HOME/versions/$VERSION/bin/matchbox" "$@"' & char( 10 )
    );
    fileSetExecutable( binDirectory & "/matchbox" );
}

/**
 * Activate an installed MatchBox version.
 *
 * @param version Version string.
 *
 * @return Nothing.
 */
function useVersion( version ) {
    version = trim( version );
    if ( !len( version ) && fileExists( ".mvmrc" ) ) {
        version = trim( fileRead( ".mvmrc" ) );
    }
    version = normalizeVersion( version );
    if ( version == "latest" || version == "snapshot" ) {
        version = normalizeVersion( getReleaseInfo( version ).tag_name );
    }
    if ( !isValidVersion( version ) ) {
        println( "Specify a valid MatchBox version or set .mvmrc." );
        cliexit( 1 );
    }

    var versionDir = MVM_VERSIONS & "/" & version;
    if ( !directoryExists( versionDir ) ) {
        println( "MatchBox " & version & " is not installed. Run: mvm install " & version );
        cliexit( 1 );
    }

    fileWrite( MVM_CURRENT, version & char( 10 ) );
    createMatchboxShim();
    println( "Now using MatchBox " & versionLabel( version, getInstalledMetadata( version ) ) );
}

/**
 * Report an MVM self-update failure consistently.
 *
 * @param message Failure message.
 * @param failFast Whether to exit immediately on failure.
 *
 * @return False.
 */
function updateFailure( message, failFast ) {
    println( "MVM update failed: " & message );
    if ( failFast ) cliexit( 1 );
    return false;
}

/**
 * Replace the running MVM binary on Unix after an update.
 *
 * @param downloadPath Temporary download path.
 * @param binaryPath Path to the MVM binary.
 *
 * @return Error message or empty.
 */
function replaceMvmOnUnix( downloadPath, binaryPath ) {
    var backupPath = binaryPath & ".previous";
    if ( fileExists( backupPath ) ) {
        try {
            fileDelete( backupPath );
        } catch ( any e ) {
            return e.message;
        }
    }
    try {
        fileMove( binaryPath, backupPath );
        fileMove( downloadPath, binaryPath );
        fileSetExecutable( binaryPath );
    } catch ( any e ) {
        if ( fileExists( backupPath ) ) {
            if ( fileExists( binaryPath ) ) fileDelete( binaryPath );
            fileMove( backupPath, binaryPath );
        }
        return e.message;
    }
    try {
        if ( fileExists( backupPath ) ) fileDelete( backupPath );
    } catch ( any e ) {}
    return "";
}

/**
 * Schedule a deferred MVM binary replacement on Windows.
 *
 * @param downloadPath Temporary download path.
 * @param binDirectory MVM bin directory.
 *
 * @return Error message or empty.
 */
function scheduleMvmUpdateOnWindows( downloadPath, binDirectory ) {
    var pendingPath = binDirectory & "/mvm-update.exe";
    var scriptPath = binDirectory & "/mvm-update.cmd";
    var quote = char( 34 );
    var newline = char( 13 ) & char( 10 );
    try {
        if ( fileExists( pendingPath ) ) fileDelete( pendingPath );
        if ( fileExists( scriptPath ) ) fileDelete( scriptPath );
        fileMove( downloadPath, pendingPath );
        fileWrite( scriptPath,
            "@echo off" & newline &
            "set /a tries=0" & newline &
            ":retry" & newline &
            "move /y " & quote & "%~dp0mvm-update.exe" & quote & " " & quote & "%~dp0mvm.exe" & quote & " >nul 2>&1" & newline &
            "if not errorlevel 1 goto done" & newline &
            "set /a tries+=1" & newline &
            "if %tries% geq 30 goto failed" & newline &
            "timeout /t 1 /nobreak >nul" & newline &
            "goto retry" & newline &
            ":done" & newline &
            "del " & quote & "%~f0" & quote & " >nul 2>&1" & newline &
            "exit /b 0" & newline &
            ":failed" & newline &
            "echo MVM update failed. Run the installer again." & newline &
            "del " & quote & "%~dp0mvm-update.exe" & quote & " >nul 2>&1" & newline &
            "exit /b 1" & newline
        );
        var launch = systemExecute(
            "cmd",
            [ "/c", "start " & quote & quote & " /b " & quote & scriptPath & quote & " >nul 2>&1" ],
            10
        );
        return launch.exitCode == 0 ? "" : "Could not start the Windows updater.";
    } catch ( any e ) {
        return e.message;
    }
}

/**
 * Download and install an MVM self-update.
 *
 * @param release GitHub release struct.
 * @param failFast Whether to exit immediately on failure.
 *
 * @return True on success.
 */
function updateMvmExecutable( release, failFast=true ) {
    var version = normalizeVersion( release.tag_name ?: "" );
    if ( !isValidVersion( version ) ) return updateFailure( "GitHub returned an invalid MVM version.", failFast );

    var binDirectory = MVM_HOME & "/bin";
    var binaryPath = binDirectory & "/mvm" & ( isWindows() ? ".exe" : "" );
    if ( !fileExists( binaryPath ) ) {
        return updateFailure( "MVM executable not found at " & binaryPath & ". Re-run the installer.", failFast );
    }
    var installedVersion = getInstalledMvmVersion( binaryPath );
    if ( len( installedVersion ) ) {
        var versionOrder = compareVersions( installedVersion, version );
        var upToDate = versionOrder > 0;
        if ( versionOrder == 0 ) {
            if ( installedVersion == version && right( version, 9 ) == "-snapshot" ) {
                var releaseCommit = getMvmReleaseCommit( release );
                upToDate = !len( releaseCommit ) || getInstalledMvmCommit( binaryPath ) == releaseCommit;
            } else {
                upToDate = installedVersion == version;
            }
        }
        if ( upToDate ) {
            println( "MVM is already up to date (" & installedVersion & ")." );
            return true;
        }
    }

    var assetUrl = findReleaseAsset( release, getPlatformAssetName( "mvm" ) );
    if ( !len( assetUrl ) ) return updateFailure( "No MVM binary exists for this platform.", failFast );
    var downloadPath = MVM_CACHE & "/mvm-" & version & "-" & createUUID() & ".download";
    println( "Downloading MVM " & version & "..." );
    var response = {};
    try {
        response = jsonDeserialize( http({ url: assetUrl, path: downloadPath, timeout: 180 }).get() );
    } catch ( any e ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        return updateFailure( e.message, failFast );
    }
    if ( response.status != 200 || !fileExists( downloadPath ) || fileInfo( downloadPath ).size == 0 ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        return updateFailure( "Download failed (HTTP " & response.status & ").", failFast );
    }

    var error = isWindows()
        ? scheduleMvmUpdateOnWindows( downloadPath, binDirectory )
        : replaceMvmOnUnix( downloadPath, binaryPath );
    if ( len( error ) ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        return updateFailure( error, failFast );
    }
    println( isWindows() ? "MVM " & version & " update will finish after this command exits." : "Updated MVM to " & version & "." );
    return true;
}

/**
 * CLI handler for mvm update.
 *
 * @return Nothing.
 */
function updateMvmCommand() {
    updateMvmExecutable( getLatestMvmRelease() );
}

/**
 * Check for a newer MVM release on interactive startup.
 *
 * @param command Current CLI command.
 *
 * @return Nothing.
 */
function checkMvmUpdateOnStartup( command ) {
    if ( !cliIsTerminal() || listFindNoCase( "help,--help,-h,version,update,completion,doctor", command ) ) return;
    var binaryPath = MVM_HOME & "/bin/mvm" & ( isWindows() ? ".exe" : "" );
    if ( !fileExists( binaryPath ) ) return;
    var nowMillis = now().getTime();
    if ( fileExists( MVM_UPDATE_CHECK ) ) {
        try {
            var lastCheck = val( trim( fileRead( MVM_UPDATE_CHECK ) ) );
            if ( lastCheck > 0 && nowMillis >= lastCheck && nowMillis - lastCheck < 86400000 ) return;
        } catch ( any e ) {}
    }
    try {
        fileWrite( MVM_UPDATE_CHECK, nowMillis & char( 10 ) );
    } catch ( any e ) {
        return;
    }

    var release = getLatestMvmRelease( false );
    if ( !release.keyExists( "tag_name" ) ) return;
    var latestVersion = normalizeVersion( release.tag_name );
    var installedVersion = getInstalledMvmVersion( binaryPath );
    var currentVersion = len( installedVersion ) ? installedVersion : MVM_VERSION;
    if ( !isValidVersion( latestVersion ) ) return;
    var versionOrder = compareVersions( latestVersion, currentVersion );
    var updateAvailable = versionOrder > 0 || ( versionOrder == 0 && latestVersion != currentVersion );
    if ( versionOrder == 0 && latestVersion == currentVersion && right( latestVersion, 9 ) == "-snapshot" ) {
        var latestCommit = getMvmReleaseCommit( release );
        updateAvailable = len( latestCommit ) && getInstalledMvmCommit( binaryPath ) != latestCommit;
    }
    if ( !updateAvailable || !len( findReleaseAsset( release, getPlatformAssetName( "mvm" ) ) ) ) return;

    var answer = "";
    try {
        answer = trim( cliread( "MVM " & latestVersion & " is available. Update now? [y/N] " ) ).lCase();
    } catch ( any e ) {
        return;
    }
    if ( answer == "y" || answer == "yes" ) updateMvmExecutable( release, false );
}

/**
 * Explain that the TUI requires an interactive terminal.
 *
 * @return Nothing.
 */
function showTui() {
    if ( !cliIsTerminal() ) {
        println( "The MVM TUI requires an interactive terminal. Use 'mvm list-remote' instead." );
        return;
    }

    var releases = getRemoteReleases();
    var installed = directoryList( MVM_VERSIONS, false, "name" );
    var current = getCurrentVersion();
    var choices = [];
    for ( release in releases ) {
        var version = normalizeVersion( release.tag_name );
        var status = version == current ? "current" : ( directoryExists( MVM_VERSIONS & "/" & version ) ? "installed" : "available" );
        if ( version == "snapshot" && directoryExists( MVM_VERSIONS & "/snapshot" ) && !sameBuild( getInstalledMetadata( version ), release.matchboxMetadata ) ) status = "update available";
        arrayAppend( choices, versionLabel( version, release.matchboxMetadata ?: {} ) & " (" & status & ")" );
    }
    for ( version in installed ) {
        var found = false;
        for ( release in releases ) {
            if ( normalizeVersion( release.tag_name ) == normalizeVersion( version ) ) found = true;
        }
        if ( !found ) arrayAppend( choices, versionLabel( normalizeVersion( version ), getInstalledMetadata( version ) ) & " (installed)" );
    }
    if ( !arrayLen( choices ) ) {
        println( "No MatchBox versions are available for this platform." );
        return;
    }

    var selected = cliselect( "Select a MatchBox version", choices );
    if ( !len( selected ) ) return;
    var selectedVersion = listFirst( selected, " " );
    if ( selectedVersion == "snapshot" || !directoryExists( MVM_VERSIONS & "/" & selectedVersion ) ) installVersion( selectedVersion );
    useVersion( selectedVersion );
}

/**
 * Remove an installed MatchBox version.
 *
 * @param version Version string.
 *
 * @return Nothing.
 */
function removeVersion( version ) {
    version = normalizeVersion( trim( version ) );
    if ( !isValidVersion( version ) ) {
        println( "Specify a valid MatchBox version to remove." );
        cliexit( 1 );
    }
    var versionDir = MVM_VERSIONS & "/" & version;
    if ( !directoryExists( versionDir ) ) {
        println( "MatchBox " & version & " is not installed." );
        return;
    }
    if ( getCurrentVersion() == version && fileExists( MVM_CURRENT ) ) fileDelete( MVM_CURRENT );
    directoryDelete( versionDir, true );
    println( "MatchBox " & version & " removed." );
}

/**
 * Print all installed MatchBox versions.
 *
 * @return Nothing.
 */
function listInstalledVersions() {
    var installed = directoryList( MVM_VERSIONS, false, "name" );
    if ( !arrayLen( installed ) ) {
        println( "No MatchBox versions installed. Run 'mvm install latest' to get started." );
        return;
    }
    var current = getCurrentVersion();
    for ( version in installed ) {
        var displayVersion = normalizeVersion( version );
        var label = versionLabel( displayVersion, getInstalledMetadata( version ) );
        println( displayVersion == current ? "▶ " & label & " (current)" : "  " & label );
    }
}

/**
 * Print the project-local .mvmrc version.
 *
 * @return Nothing.
 */
function showLocalVersion() {
    if ( !fileExists( ".mvmrc" ) ) {
        println( "No local MatchBox version is set." );
        return;
    }
    println( "Local MatchBox version: " & trim( fileRead( ".mvmrc" ) ) );
}

/**
 * Print the active MatchBox version.
 *
 * @return Nothing.
 */
function showCurrent() {
    var current = getCurrentVersion();
    if ( !len( current ) ) {
        println( "No MatchBox version is active. Run 'mvm use <version>'." );
        return;
    }
    println( "Current MatchBox version: " & versionLabel( current, getInstalledMetadata( current ) ) );
}

/**
 * Clear the MVM download cache.
 *
 * @return Nothing.
 */
function cleanCache() {
    if ( directoryExists( MVM_CACHE ) ) directoryDelete( MVM_CACHE, true );
    directoryCreate( MVM_CACHE );
    println( "MVM download cache cleared." );
}

/**
 * Generate the shell-specific MVM initialization script.
 *
 * @param shellName Shell identifier.
 *
 * @return Script contents.
 */
function getShellInitScript( shellName ) {
    var lines = [];
    if ( shellName == "fish" ) {
        arrayAppend( lines, 'set -q MVM_HOME; or set -gx MVM_HOME "$HOME/.mvm"' );
        arrayAppend( lines, 'if not contains -- "$MVM_HOME/bin" $PATH' );
        arrayAppend( lines, '    set -gx PATH "$MVM_HOME/bin" $PATH' );
        arrayAppend( lines, 'end' );
        arrayAppend( lines, 'set -q MATCHBOX_HOME; or set -gx MATCHBOX_HOME "$HOME/.matchbox"' );
        arrayAppend( lines, 'if not contains -- "$MATCHBOX_HOME/bin" $PATH' );
        arrayAppend( lines, '    set -gx PATH "$MATCHBOX_HOME/bin" $PATH' );
        arrayAppend( lines, 'end' );
        arrayAppend( lines, 'test -s "$MVM_HOME/completions/mvm.fish"; and source "$MVM_HOME/completions/mvm.fish"' );
    } else if ( shellName == "powershell" ) {
        arrayAppend( lines, "if (-not $env:MVM_HOME) { $env:MVM_HOME = Join-Path $HOME '.mvm' }" );
        arrayAppend( lines, "$mvmBin = Join-Path $env:MVM_HOME 'bin'" );
        arrayAppend( lines, "$pathEntries = $env:Path -split [IO.Path]::PathSeparator" );
        arrayAppend( lines, 'if ($pathEntries -notcontains $mvmBin) { $env:Path = "$mvmBin$([IO.Path]::PathSeparator)$env:Path" }' );
        arrayAppend( lines, "if (-not $env:MATCHBOX_HOME) { $env:MATCHBOX_HOME = Join-Path $HOME '.matchbox' }" );
        arrayAppend( lines, "$matchboxBin = Join-Path $env:MATCHBOX_HOME 'bin'" );
        arrayAppend( lines, 'if ($pathEntries -notcontains $matchboxBin) { $env:Path = "$matchboxBin$([IO.Path]::PathSeparator)$env:Path" }' );
    } else {
        arrayAppend( lines, 'export MVM_HOME="${MVM_HOME:-$HOME/.mvm}"' );
        arrayAppend( lines, 'case ":$PATH:" in' );
        arrayAppend( lines, '    *":$MVM_HOME/bin:"*) ;;' );
        arrayAppend( lines, '    *) export PATH="$MVM_HOME/bin:$PATH" ;;' );
        arrayAppend( lines, 'esac' );
        arrayAppend( lines, 'MATCHBOX_HOME="${MATCHBOX_HOME:-$HOME/.matchbox}"' );
        arrayAppend( lines, 'export MATCHBOX_HOME' );
        arrayAppend( lines, 'case ":$PATH:" in' );
        arrayAppend( lines, '    *":$MATCHBOX_HOME/bin:"*) ;;' );
        arrayAppend( lines, '    *) export PATH="$MATCHBOX_HOME/bin:$PATH" ;;' );
        arrayAppend( lines, 'esac' );
        if ( shellName == "bash" ) {
            arrayAppend( lines, 'if [ -n "${BASH_VERSION:-}" ] && [ -r "$MVM_HOME/completions/mvm.bash" ]; then . "$MVM_HOME/completions/mvm.bash"; fi' );
        } else if ( shellName == "zsh" ) {
            arrayAppend( lines, 'if [ -n "${ZSH_VERSION:-}" ]; then' );
            arrayAppend( lines, '    if ! command -v compdef >/dev/null 2>&1; then autoload -U +X compinit && compinit -u; fi' );
            arrayAppend( lines, '    [ -r "$MVM_HOME/completions/mvm.zsh" ] && . "$MVM_HOME/completions/mvm.zsh"' );
            arrayAppend( lines, 'fi' );
        }
    }
    return arrayToList( lines, char( 10 ) ) & char( 10 );
}

/**
 * Generate the shell profile hook that sources MVM init.
 *
 * @param shellName Shell identifier.
 *
 * @return Hook contents.
 */
function getShellProfileHook( shellName ) {
    var lines = [ char( 35 ) & " MVM shell initialization" ];
    var home = getsystemsetting( "HOME", getsystemsetting( "USERPROFILE", "" ) );
    var defaultMvmHome = home & "/.mvm";
    var configuredMvmHome = replace( MVM_HOME, char( 92 ), "/", "all" );
    var defaultMvmHomePath = replace( defaultMvmHome, char( 92 ), "/", "all" );
    var isDefaultMvmHome = shellName == "powershell"
        ? configuredMvmHome.lCase() == defaultMvmHomePath.lCase()
        : configuredMvmHome == defaultMvmHomePath;
    if ( shellName == "fish" ) {
        var fishFallback = isDefaultMvmHome ? '"$HOME/.mvm"' : "'" & replace( replace( MVM_HOME, char( 92 ), char( 92 ) & char( 92 ), "all" ), "'", char( 92 ) & "'", "all" ) & "'";
        arrayAppend( lines, "set -q MVM_HOME; or set -gx MVM_HOME " & fishFallback );
        arrayAppend( lines, 'test -s "$MVM_HOME/scripts/mvm-init.fish"; and source "$MVM_HOME/scripts/mvm-init.fish"' );
    } else if ( shellName == "powershell" ) {
        var powershellFallback = isDefaultMvmHome ? "Join-Path $HOME '.mvm'" : "'" & replace( MVM_HOME, "'", "''", "all" ) & "'";
        arrayAppend( lines, "$env:MVM_PROFILE = $PROFILE" );
        arrayAppend( lines, "if (-not $env:MVM_HOME) { $env:MVM_HOME = " & powershellFallback & " }" );
        arrayAppend( lines, "$mvmInit = Join-Path $env:MVM_HOME 'scripts/mvm-init.ps1'" );
        arrayAppend( lines, 'if (Test-Path -LiteralPath $mvmInit) { . $mvmInit }' );
    } else {
        if ( isDefaultMvmHome ) arrayAppend( lines, 'export MVM_HOME="${MVM_HOME:-$HOME/.mvm}"' );
        else {
            var shellFallback = "'" & replace( MVM_HOME, "'", "'" & char( 92 ) & "''", "all" ) & "'";
            arrayAppend( lines, "export MVM_HOME=${MVM_HOME:-" & shellFallback & "}" );
        }
        arrayAppend( lines, '[ -s "$MVM_HOME/scripts/mvm-init.sh" ] && . "$MVM_HOME/scripts/mvm-init.sh"' );
    }
    return arrayToList( lines, char( 10 ) );
}

/**
 * Insert or replace the MVM hook in a shell profile.
 *
 * @param profile Shell profile path.
 * @param hook Hook text to write.
 *
 * @return Nothing.
 */
function updateShellProfile( profile, hook ) {
    var contents = fileExists( profile ) ? fileRead( profile ) : "";
    var lineEnding = find( char( 13 ) & char( 10 ), contents ) ? char( 13 ) & char( 10 ) : char( 10 );
    var marker = char( 35 ) & " MVM";
    var slash = char( 92 );
    var literalDollar = slash & char( 36 );
    var lineBreak = slash & "r?" & slash & "n";
    var anyLine = "[^" & slash & "r" & slash & "n]*";
    var homePattern = "(?:export MVM_HOME=" & anyLine & "|set -gx MVM_HOME " & anyLine & "|" & literalDollar & "env:MVM_HOME = " & anyLine & ")";
    var pathPattern = "(?:export PATH=" & anyLine & "|set -gx PATH " & anyLine & "|if " & slash & "(" & literalDollar & "env:Path" & anyLine & ")";
    var legacyPattern = "(?m)^" & marker & lineBreak & homePattern & lineBreak & pathPattern & lineBreak & "?";
    contents = reReplace( contents, legacyPattern, "", "all" );
    var completionPattern = "(?m)^" & marker & " bash completion" & lineBreak & anyLine & "MVM_HOME/completions/mvm" & slash & ".bash" & anyLine & lineBreak & "?";
    contents = reReplace( contents, completionPattern, "", "all" );
    var comparableContents = replace( contents, char( 13 ) & char( 10 ), char( 10 ), "all" );
    if ( !findNoCase( trim( hook ), comparableContents ) ) {
        if ( len( trim( contents ) ) ) {
            if ( right( contents, 1 ) != char( 10 ) ) contents &= lineEnding;
            contents &= lineEnding;
        }
        var profileHook = replace( hook, char( 10 ), lineEnding, "all" );
        contents &= profileHook & lineEnding;
    }
    var profileDirectory = getDirectoryFromPath( profile );
    if ( !directoryExists( profileDirectory ) ) directoryCreate( profileDirectory );
    fileWrite( profile, contents );
}

/**
 * Inspect or repair shell initialization, PATH hook, and completions.
 *
 * @param fix Whether to repair detected issues.
 *
 * @return Status struct.
 */
function shellInitializationStatus( fix=false ) {
    var windows = isWindows();
    var shellName = "";
    var osName = "";
    var home = getsystemsetting( "HOME", getsystemsetting( "USERPROFILE", "" ) );
    if ( windows ) {
        shellName = "powershell";
        osName = "windows";
    } else {
        var shellPath = getsystemsetting( "SHELL", "" );
        shellName = listLast( replace( shellPath, char( 92 ), "/", "all" ), "/" ).lCase();
        osName = trim( systemExecute( "uname", [ "-s" ], 10 ).output ).lCase();
    }
    if ( !len( trim( home ) ) ) return { supported: false, configured: false };

    var profile = "";
    var loginReady = true;
    if ( windows ) {
        profile = getsystemsetting( "MVM_PROFILE", "" );
        if ( !len( profile ) ) {
            var psProfileDirectory = findNoCase( "WindowsPowerShell", getsystemsetting( "PSModulePath", "" ) )
                ? "WindowsPowerShell"
                : "PowerShell";
            profile = home & "/Documents/" & psProfileDirectory & "/Microsoft.PowerShell_profile.ps1";
        }
    } else if ( shellName == "bash" && osName == "darwin" ) {
        profile = home & "/.bashrc";
        var loginProfile = home & "/.bash_profile";
        var loginContents = fileExists( loginProfile ) ? fileRead( loginProfile ) : "";
        var bridgeMarker = "MVM Bash login bridge";
        var bridged = findNoCase( bridgeMarker, loginContents ) > 0 && findNoCase( ".bashrc", loginContents ) > 0;
        if ( fileExists( loginProfile ) && !bridged ) {
            profile = loginProfile;
        } else if ( fix && !bridged ) {
            var bridgeLines = [];
            if ( findNoCase( bridgeMarker, loginContents ) == 0 ) arrayAppend( bridgeLines, char( 35 ) & " " & bridgeMarker );
            if ( fileExists( home & "/.bash_login" ) && findNoCase( ".bash_login", loginContents ) == 0 ) {
                arrayAppend( bridgeLines, '[ -r "$HOME/.bash_login" ] && . "$HOME/.bash_login"' );
            } else if ( fileExists( home & "/.profile" ) && findNoCase( ".profile", loginContents ) == 0 ) {
                arrayAppend( bridgeLines, '[ -r "$HOME/.profile" ] && . "$HOME/.profile"' );
            }
            var bashrcLine = '[ -r "$HOME/.bashrc" ] && . "$HOME/.bashrc"';
            if ( findNoCase( bashrcLine, loginContents ) == 0 ) arrayAppend( bridgeLines, bashrcLine );
            fileWrite( loginProfile, ( len( loginContents ) ? loginContents & char( 10 ) : "" ) & arrayToList( bridgeLines, char( 10 ) ) & char( 10 ) );
            bridged = true;
        }
        if ( !fileExists( loginProfile ) || bridged ) {
            profile = home & "/.bashrc";
            loginReady = bridged;
        }
    } else if ( !windows && shellName == "fish" ) {
        profile = home & "/.config/fish/config.fish";
    } else if ( !windows && shellName == "zsh" ) {
        profile = home & "/.zshrc";
    } else if ( !windows && shellName == "bash" ) {
        profile = home & "/.bashrc";
    } else if ( !windows ) {
        profile = home & "/.profile";
    }

    var extension = shellName == "fish" ? "fish" : ( shellName == "powershell" ? "ps1" : "sh" );
    var initFile = MVM_HOME & "/scripts/mvm-init." & extension;
    var initScript = getShellInitScript( shellName );
    var hook = getShellProfileHook( shellName );
    var profileContents = fileExists( profile ) ? fileRead( profile ) : "";
    var normalizedProfile = replace( profileContents, char( 13 ) & char( 10 ), char( 10 ), "all" );
    var registered = findNoCase( trim( hook ), normalizedProfile ) > 0;
    var scriptCurrent = fileExists( initFile ) && trim( fileRead( initFile ) ) == trim( initScript );
    var completionEnabled = !windows && listFindNoCase( MVM_COMPLETION_SHELLS, shellName ) > 0 && ( osName == "linux" || osName == "darwin" );
    var completionShell = completionEnabled ? shellName.lCase() : "";
    var completionSupported = len( completionShell ) > 0;
    var completionFile = completionSupported ? MVM_HOME & "/completions/mvm." & completionShell : "";
    var completionScript = completionSupported ? getCompletionScript( completionShell ) : "";
    var completionCurrent = !completionSupported || ( fileExists( completionFile ) && trim( fileRead( completionFile ) ) == trim( completionScript ) );

    if ( fix ) {
        var scriptsDirectory = MVM_HOME & "/scripts";
        if ( !directoryExists( scriptsDirectory ) ) directoryCreate( scriptsDirectory );
        fileWrite( initFile, initScript );
        if ( completionSupported ) {
            var completionDirectory = MVM_HOME & "/completions";
            if ( !directoryExists( completionDirectory ) ) directoryCreate( completionDirectory );
            fileWrite( completionDirectory & "/mvm.bash", getBashCompletionScript() );
            fileWrite( completionDirectory & "/mvm.zsh", getZshCompletionScript() );
            fileWrite( completionDirectory & "/mvm.fish", getFishCompletionScript() );
        }
        updateShellProfile( profile, hook );
        profileContents = fileRead( profile );
        normalizedProfile = replace( profileContents, char( 13 ) & char( 10 ), char( 10 ), "all" );
        registered = findNoCase( trim( hook ), normalizedProfile ) > 0;
        scriptCurrent = true;
        completionCurrent = true;
    }
    return {
        supported: true,
        configured: scriptCurrent && registered && completionCurrent && loginReady,
        profile: profile,
        initFile: initFile,
        shell: shellName,
        completionSupported: completionSupported,
        completionShell: completionShell,
        completionCurrent: completionCurrent,
        completionFile: completionFile
    };
}

/**
 * Run MVM health checks and optional repairs.
 *
 * @param fixShellInitialization Function argument.
 *
 * @return Nothing.
 */
function doctor( fixShellInitialization=false ) {
    var shellInitialization = {};
    try {
        shellInitialization = shellInitializationStatus( fixShellInitialization );
    } catch ( any e ) {
        println( "Could not inspect or repair shell initialization: " & e.message );
        cliexit( 1 );
    }
    if ( fixShellInitialization && !shellInitialization.supported ) {
        println( "Shell initialization repair requires a supported user shell." );
        cliexit( 1 );
    }
    if ( shellInitialization.supported ) {
        if ( fixShellInitialization ) println( "MVM shell initialization installed at " & shellInitialization.initFile & ". Restart your shell or source " & shellInitialization.profile & "." );
        else if ( !shellInitialization.configured ) println( "MVM shell initialization is missing or stale. Run 'mvm doctor --fix'." );
        else println( "MVM shell initialization is configured." );
        if ( shellInitialization.completionSupported ) {
            var completionLabel = shellInitialization.completionShell == "fish" ? "Fish" : ( shellInitialization.completionShell == "zsh" ? "Zsh" : "Bash" );
            if ( fixShellInitialization ) println( completionLabel & " completions installed at " & shellInitialization.completionFile & "." );
            else if ( !shellInitialization.completionCurrent ) println( completionLabel & " completions are missing or stale. Run 'mvm doctor --fix'." );
            else println( completionLabel & " completions are configured." );
        }
    }

    var windows = isWindows();
    var binDirectory = MVM_HOME & "/bin";
    var expectedBin = binDirectory;
    if ( windows ) expectedBin = replace( expectedBin, char( 92 ), "/", "all" ).lCase();
    var path = getsystemsetting( "PATH", "" );
    var pathEntries = listToArray( path, windows ? ";" : ":" );
    var binOnPath = false;
    for ( pathEntry in pathEntries ) {
        pathEntry = trim( pathEntry );
        if ( windows ) pathEntry = replace( pathEntry, char( 92 ), "/", "all" ).lCase();
        if ( pathEntry == expectedBin ) binOnPath = true;
    }

    println( "MVM version: " & MVM_VERSION );
    println( "MVM_HOME: " & MVM_HOME );
    println( "MATCHBOX_HOME: " & MATCHBOX_HOME );
    if ( !binOnPath ) {
        println( "MVM bin directory is not on PATH: " & binDirectory );
        cliexit( 1 );
    }

    if ( !fileExists( MVM_CURRENT ) ) {
        println( "No MatchBox version is active. Run 'mvm use latest'." );
        println( "MVM is healthy." );
        return;
    }

    var current = getCurrentVersion();
    if ( !len( current ) ) {
        println( "Invalid active version marker: " & MVM_CURRENT );
        cliexit( 1 );
    }
    var binaryName = windows ? "matchbox.exe" : "matchbox";
    var binaryPath = MVM_VERSIONS & "/" & current & "/bin/" & binaryName;
    if ( !fileExists( binaryPath ) ) {
        println( "Active MatchBox binary is missing: " & binaryPath );
        cliexit( 1 );
    }
    var shimPath = binDirectory & "/matchbox" & ( windows ? ".cmd" : "" );
    if ( !fileExists( shimPath ) ) {
        println( "MatchBox command shim is missing. Run 'mvm use " & current & "'." );
        cliexit( 1 );
    }
    println( "Active MatchBox: " & current );
    println( "matchbox command is available." );
    println( "MVM is healthy." );
}

/**
 * Extract arguments to forward to MatchBox from CLI positionals.
 *
 * @param positionals Positional CLI arguments.
 *
 * @return Argument array.
 */
function getForwardedArgs( positionals ) {
    var forwarded = [];
    for ( var i = 2; i <= arrayLen( positionals ); i++ ) arrayAppend( forwarded, positionals[ i ] );
    return forwarded;
}

/**
 * Execute the active MatchBox version with forwarded arguments.
 *
 * @param execArguments Arguments to forward.
 * @param cliOptions Parsed CLI options.
 *
 * @return Nothing.
 */
function execCurrentVersion( execArguments, cliOptions ) {
    var current = getCurrentVersion();
    if ( !len( current ) ) {
        println( "No MatchBox version is active. Run 'mvm use <version>'." );
        cliexit( 1 );
    }
    var binaryName = isWindows() ? "matchbox.exe" : "matchbox";
    var binaryPath = MVM_VERSIONS & "/" & current & "/bin/" & binaryName;
    if ( !fileExists( binaryPath ) ) {
        println( "MatchBox binary not found: " & binaryPath );
        cliexit( 1 );
    }
    for ( option in cliOptions ) {
        var optionValue = cliOptions[ option ];
        arrayAppend( execArguments, optionValue == false ? "--no-" & option : "--" & option & ( optionValue == true ? "" : "=" & optionValue ) );
    }
    var result = {};
    try {
        result = systemExecute( binaryPath, execArguments, 0, false, null, null, null, true, {}, true );
    } catch ( any e ) {
        println( "Could not execute MatchBox: " & e.message );
        cliexit( 1 );
    }
    if ( isNull( result.exitCode ) || result.exitCode != 0 ) cliexit( isNull( result.exitCode ) ? 1 : result.exitCode );
}

/**
 * Return the command descriptions shared by all completion scripts.
 *
 * @return Array of "command:description" entries.
 */
function getMvmCommandDescriptions() {
    return [
        "install:Install a MatchBox version",
        "update:Update the MVM executable",
        "use:Activate a version or read .mvmrc",
        "local:Set or show the local .mvmrc version",
        "current:Show the active MatchBox version",
        "doctor:Check MVM health",
        "clean:Clear temporary downloads",
        "list:List installed versions",
        "ls:List installed versions",
        "list-remote:List versions available to install",
        "remove:Remove an installed version",
        "uninstall:Remove an installed version",
        "exec:Run MatchBox with the active version",
        "run:Run MatchBox with the active version",
        "tui:Browse and activate versions",
        "version:Show MVM version information",
        "completion:Print a shell completion script",
        "help:Show help"
    ];
}

/**
 * Return the Bash completion script for MVM commands.
 *
 * @return Bash script.
 */
function getBashCompletionScript() {
    var lines = [];
    arrayAppend( lines, char( 35 ) & ' Bash completion for MVM' );
    arrayAppend( lines, '_mvm_versions() {' );
    arrayAppend( lines, '  local version' );
    arrayAppend( lines, '  local -a versions=()' );
    arrayAppend( lines, '  for version in "${MVM_HOME:-$HOME/.mvm}/versions/"*; do' );
    arrayAppend( lines, '    [[ -d $version ]] || continue' );
    arrayAppend( lines, '    versions+=( "$(basename "$version")" )' );
    arrayAppend( lines, '  done' );
    arrayAppend( lines, '  [[ -z "${versions[*]}" ]] && return 0' );
    arrayAppend( lines, '  printf "%s\n" "${versions[@]}"' );
    arrayAppend( lines, '}' );
    arrayAppend( lines, '_mvm_completions() {' );
    arrayAppend( lines, '  local cur="${COMP_WORDS[COMP_CWORD]}"' );
    arrayAppend( lines, '  local command="${COMP_WORDS[1]:-}"' );
    arrayAppend( lines, '  if (( COMP_CWORD == 1 )); then' );
    arrayAppend( lines, '    COMPREPLY=( $(compgen -W "' & MVM_COMMANDS & '" -- "$cur") )' );
    arrayAppend( lines, '    return 0' );
    arrayAppend( lines, '  fi' );
    arrayAppend( lines, '  (( COMP_CWORD == 2 )) || return 0' );
    arrayAppend( lines, '  case $command in' );
    arrayAppend( lines, '    install)' );
    arrayAppend( lines, '      if [[ $cur == -* ]]; then' );
    arrayAppend( lines, '        COMPREPLY=( $(compgen -W "--force" -- "$cur") )' );
    arrayAppend( lines, '      else' );
    arrayAppend( lines, '        COMPREPLY=( $(compgen -W "latest snapshot" -- "$cur") )' );
    arrayAppend( lines, '      fi' );
    arrayAppend( lines, '      ;;' );
    arrayAppend( lines, '    use|local)' );
    arrayAppend( lines, '      COMPREPLY=( $(compgen -W "latest snapshot $(_mvm_versions)" -- "$cur") )' );
    arrayAppend( lines, '      ;;' );
    arrayAppend( lines, '    remove|uninstall)' );
    arrayAppend( lines, '      COMPREPLY=( $(compgen -W "$(_mvm_versions)" -- "$cur") )' );
    arrayAppend( lines, '      ;;' );
    arrayAppend( lines, '    doctor) COMPREPLY=( $(compgen -W "--fix" -- "$cur") ) ;;' );
    arrayAppend( lines, '    completion) COMPREPLY=( $(compgen -W "' & replace( MVM_COMPLETION_SHELLS, ",", " ", "all" ) & '" -- "$cur") ) ;;' );
    arrayAppend( lines, '  esac' );
    arrayAppend( lines, '}' );
    arrayAppend( lines, 'complete -o default -F _mvm_completions mvm' );
    return arrayToList( lines, char( 10 ) ) & char( 10 );
}

/**
 * Return the Zsh completion script for MVM commands.
 *
 * @return Zsh script.
 */
function getZshCompletionScript() {
    var quote = char( 34 );
    var lines = [];
    arrayAppend( lines, char( 35 ) & 'compdef mvm' );
    arrayAppend( lines, char( 35 ) & ' Zsh completion for MVM' );
    arrayAppend( lines, '_mvm_installed_versions() {' );
    arrayAppend( lines, '  local dir="${MVM_HOME:-$HOME/.mvm}/versions"' );
    arrayAppend( lines, '  local version' );
    arrayAppend( lines, '  [[ -d $dir ]] || return 0' );
    arrayAppend( lines, '  for version in "$dir"/*(N); do' );
    arrayAppend( lines, '    [[ -d $version ]] || continue' );
    arrayAppend( lines, '    compadd -- "${version:t}"' );
    arrayAppend( lines, '  done' );
    arrayAppend( lines, '}' );
    arrayAppend( lines, '_mvm() {' );
    arrayAppend( lines, '  local -a commands' );
    arrayAppend( lines, '  commands=(' );
    for ( var description in getMvmCommandDescriptions() ) {
        arrayAppend( lines, '    ' & quote & description & quote );
    }
    arrayAppend( lines, '  )' );
    arrayAppend( lines, '  if (( CURRENT == 2 )); then' );
    arrayAppend( lines, '    _describe -t commands "mvm command" commands' );
    arrayAppend( lines, '    compadd -- --help' );
    arrayAppend( lines, '    return 0' );
    arrayAppend( lines, '  fi' );
    arrayAppend( lines, '  case $words[2] in' );
    arrayAppend( lines, '    install)' );
    arrayAppend( lines, '      if [[ $words[CURRENT] == -* ]]; then' );
    arrayAppend( lines, '        compadd -- --force' );
    arrayAppend( lines, '      else' );
    arrayAppend( lines, '        compadd -- latest snapshot' );
    arrayAppend( lines, '      fi' );
    arrayAppend( lines, '      ;;' );
    arrayAppend( lines, '    use|local)' );
    arrayAppend( lines, '      compadd -- latest snapshot' );
    arrayAppend( lines, '      _mvm_installed_versions' );
    arrayAppend( lines, '      ;;' );
    arrayAppend( lines, '    remove|uninstall)' );
    arrayAppend( lines, '      _mvm_installed_versions' );
    arrayAppend( lines, '      ;;' );
    arrayAppend( lines, '    doctor) compadd -- --fix ;;' );
    arrayAppend( lines, '    completion) compadd -- ' & replace( MVM_COMPLETION_SHELLS, ",", " ", "all" ) & ' ;;' );
    arrayAppend( lines, '  esac' );
    arrayAppend( lines, '}' );
    arrayAppend( lines, '(( $+functions[compdef] )) && compdef _mvm mvm' );
    return arrayToList( lines, char( 10 ) ) & char( 10 );
}

/**
 * Return the Fish completion script for MVM commands.
 *
 * @return Fish script.
 */
function getFishCompletionScript() {
    var quote = char( 34 );
    var lines = [];
    arrayAppend( lines, char( 35 ) & ' Fish completion for MVM' );
    arrayAppend( lines, 'function __mvm_versions' );
    arrayAppend( lines, '  set -l dir (set -q MVM_HOME; and echo $MVM_HOME; or echo $HOME/.mvm)/versions' );
    arrayAppend( lines, '  test -d $dir; or return' );
    arrayAppend( lines, '  for mvmVersion in $dir/*' );
    arrayAppend( lines, '    test -d $mvmVersion; or continue' );
    arrayAppend( lines, '    basename $mvmVersion' );
    arrayAppend( lines, '  end' );
    arrayAppend( lines, 'end' );
    arrayAppend( lines, 'if not set -q __mvm_completions_loaded' );
    arrayAppend( lines, '  set -g __mvm_completions_loaded 1' );
    arrayAppend( lines, '  set -l commands ' & MVM_COMMANDS );
    arrayAppend( lines, '  complete -c mvm -f' );
    for ( var description in getMvmCommandDescriptions() ) {
        var parts = listToArray( description, ":" );
        arrayAppend( lines, '  complete -c mvm -n ' & quote & 'not __fish_seen_subcommand_from $commands' & quote & ' -a ' & parts[1] & ' -d ' & quote & parts[2] & quote & ';' );
    }
    arrayAppend( lines, '  complete -c mvm -n ' & quote & 'not __fish_seen_subcommand_from $commands' & quote & ' -s h -l help -d ' & quote & 'Show help' & quote & ';' );
    arrayAppend( lines, '  complete -c mvm -n ' & quote & '__fish_seen_subcommand_from install' & quote & ' -a ' & quote & 'latest snapshot' & quote & ' -d ' & quote & 'Release channel' & quote & ';' );
    arrayAppend( lines, '  complete -c mvm -n ' & quote & '__fish_seen_subcommand_from install' & quote & ' -l force -d ' & quote & 'Reinstall an existing version' & quote & ';' );
    arrayAppend( lines, '  complete -c mvm -n ' & quote & '__fish_seen_subcommand_from use local' & quote & ' -a ' & quote & 'latest snapshot' & quote & ' -d ' & quote & 'Release channel' & quote & ';' );
    arrayAppend( lines, '  complete -c mvm -n ' & quote & '__fish_seen_subcommand_from use local remove uninstall' & quote & ' -a ' & quote & '(__mvm_versions)' & quote & ' -d ' & quote & 'Installed version' & quote & ';' );
    arrayAppend( lines, '  complete -c mvm -n ' & quote & '__fish_seen_subcommand_from doctor' & quote & ' -l fix -d ' & quote & 'Repair shell initialization' & quote & ';' );
    arrayAppend( lines, '  complete -c mvm -n ' & quote & '__fish_seen_subcommand_from completion' & quote & ' -a ' & quote & replace( MVM_COMPLETION_SHELLS, ",", " ", "all" ) & quote & ' -d ' & quote & 'Shell' & quote & ';' );
    arrayAppend( lines, '  complete -c mvm -n ' & quote & '__fish_seen_subcommand_from exec run' & quote & ' -F' );
    arrayAppend( lines, 'end' );
    return arrayToList( lines, char( 10 ) ) & char( 10 );
}

/**
 * Return the completion script for a shell.
 *
 * @param shellName Shell identifier.
 *
 * @return Completion script, or an empty string for unsupported shells.
 */
function getCompletionScript( shellName ) {
    var normalizedShell = trim( shellName ).lCase();
    switch ( normalizedShell ) {
        case "bash":
            return getBashCompletionScript();
        case "zsh":
            return getZshCompletionScript();
        case "fish":
            return getFishCompletionScript();
        default:
            return "";
    }
}

/**
 * Print the completion script for a shell.
 *
 * @param shellName Shell identifier.
 *
 * @return Nothing.
 */
function showCompletion( shellName ) {
    var script = getCompletionScript( shellName );
    if ( !len( script ) ) {
        println( "Usage: mvm completion <" & replace( MVM_COMPLETION_SHELLS, ",", "|", "all" ) & ">" );
        cliexit( 1 );
    }
    print( script );
}

/**
 * Print the MVM CLI help text.
 *
 * @return Nothing.
 */
function showHelp() {
    println( "📦 MatchBox Version Manager (MVM) v" & MVM_VERSION );
    println( "" );
    println( "USAGE: mvm <command> [arguments]" );
    println( "" );
    println( "  install <version>     Install a MatchBox version" );
    println( "  update                Update the MVM executable" );
    println( "  use [version]         Activate a version or read .mvmrc" );
    println( "  local [version]       Set or show the current directory's .mvmrc" );
    println( "  current               Show the active MatchBox version" );
    println( "  doctor [--fix]        Check MVM; --fix repairs shell initialization" );
    println( "  clean                 Clear temporary download files" );
    println( "  list                  List installed versions" );
    println( "  list-remote           List versions available to install" );
    println( "  remove <version>      Remove an installed version" );
    println( "  exec <args...>        Run MatchBox with the active version" );
    println( "  run <args...>         Alias for exec" );
    println( "  tui                   Browse, install, and activate versions" );
    println( "  version               Show MVM version" );
    println( "  completion <shell>    Print completion script (bash, zsh, or fish)" );
    println( "  help                  Show this help" );
    println( "" );
    println( "  install <version> --force  Reinstall an existing version" );
    println( "" );
    println( "MVM_HOME defaults to ~/.mvm" );
}

var cli = cligetargs();
var args = cli.positionals;
var command = arrayLen( args ) ? trim( args[ 1 ] ) : "";

checkMvmUpdateOnStartup( command );

switch ( command ) {
    case "":
    case "help":
    case "--help":
    case "-h":
        showHelp();
        break;
    case "use":
        useVersion( arrayLen( args ) >= 2 ? args[ 2 ] : "" );
        break;
    case "local":
        if ( arrayLen( args ) < 2 || !len( trim( args[ 2 ] ) ) ) {
            showLocalVersion();
        } else {
            fileWrite( ".mvmrc", trim( args[ 2 ] ) & char( 10 ) );
            println( "Local MatchBox version set to " & trim( args[ 2 ] ) );
        }
        break;
    case "current":
        showCurrent();
        break;
    case "doctor":
        doctor( cli.options.keyExists( "fix" ) && cli.options.fix );
        break;
    case "clean":
        cleanCache();
        break;
    case "install":
        installVersion( arrayLen( args ) >= 2 ? args[ 2 ] : "latest", cli.options.keyExists( "force" ) && cli.options.force );
        break;
    case "update":
        updateMvmCommand();
        break;
    case "exec":
    case "run":
        execCurrentVersion( getForwardedArgs( args ), cli.options );
        break;
    case "remove":
    case "uninstall":
        removeVersion( arrayLen( args ) >= 2 ? args[ 2 ] : "" );
        break;
    case "tui":
        showTui();
        break;
    case "list-remote":
        listRemoteVersions();
        break;
    case "version":
        println( "MVM version: " & MVM_VERSION );
        println( "Commit: " & MVM_COMMIT );
        println( "Built on: " & MVM_BUILT_ON );
        break;
    case "completion":
        showCompletion( arrayLen( args ) >= 2 ? args[ 2 ] : "" );
        break;
    case "list":
    case "ls":
        listInstalledVersions();
        break;
    default:
        println( "Unknown command: " & command & ". Run 'mvm help' for usage." );
        cliexit( 1 );
}
