MVM_VERSION = "0.1.0";
MVM_HOME = getsystemsetting( "MVM_HOME", getsystemsetting( "HOME", getsystemsetting( "USERPROFILE", "~" ) ) & "/.mvm" );
MVM_VERSIONS = MVM_HOME & "/versions";
MVM_CACHE = MVM_HOME & "/cache";
MVM_CURRENT = MVM_HOME & "/current";
MATCHBOX_GITHUB_API = "https://api.github.com/repos/ortus-boxlang/matchbox";

if ( !directoryExists( MVM_HOME ) ) directoryCreate( MVM_HOME );
if ( !directoryExists( MVM_VERSIONS ) ) directoryCreate( MVM_VERSIONS );
if ( !directoryExists( MVM_CACHE ) ) directoryCreate( MVM_CACHE );

function githubJson( url ) {
    var response = {};
    try {
        response = jsonDeserialize( http({
            url: url,
            headers: { "User-Agent": "MVM" },
            timeout: 30
        }).get() );
    } catch ( any e ) {
        println( "Could not contact GitHub: " & e.message );
        cliexit( 1 );
    }
    if ( response.status != 200 ) {
        println( "GitHub request failed with HTTP " & response.status );
        cliexit( 1 );
    }
    return jsonDeserialize( response.body );
}

function isWindows() {
    return getsystemsetting( "OS", "" ).lCase() contains "windows";
}

function getPlatformAssetName() {
    var windows = isWindows();
    var os = "";
    if ( windows ) {
        os = "windows";
    } else {
        var osResult = systemExecute( "uname", [ "-s" ], 10 );
        var osName = trim( osResult.output ).lCase();
        if ( osName contains "linux" ) os = "linux";
        if ( osName contains "darwin" ) os = "macos";
        if ( !len( os ) ) {
            println( "Unsupported operating system: " & osName );
            cliexit( 1 );
        }
    }

    var arch = windows
        ? getsystemsetting( "PROCESSOR_ARCHITECTURE", "x64" ).lCase()
        : trim( systemExecute( "uname", [ "-m" ], 10 ).output ).lCase();
    if ( arch == "x86_64" || arch == "amd64" || arch == "x64" ) arch = "x64";
    else if ( arch == "aarch64" || arch == "arm64" ) arch = "arm64";
    else if ( arch == "i386" || arch == "i686" || arch == "x86" ) arch = "x86";
    else if ( arch.startsWith( "armv7" ) ) arch = "armv7";
    else {
        println( "Unsupported architecture: " & arch );
        cliexit( 1 );
    }
    return "matchbox-" & os & "-" & arch & ( windows ? ".exe" : "" );
}

function normalizeVersion( version ) {
    version = trim( version );
    return version.startsWith( "v" ) ? listLast( version, "v" ) : version;
}

function listRemoteVersions() {
    var releases = githubJson( MATCHBOX_GITHUB_API & "/releases?per_page=100" );
    var assetName = getPlatformAssetName();
    var latestShown = false;
    println( "Available MatchBox versions:" );
    for ( release in releases ) {
        var version = normalizeVersion( release.tag_name );
        if ( !isValidVersion( version ) ) continue;
        var hasAsset = false;
        for ( asset in release.assets ) {
            if ( asset.name == assetName ) hasAsset = true;
        }
        if ( hasAsset ) {
            var suffix = release.prerelease ? " (pre-release)" : ( !latestShown ? " (latest)" : "" );
            println( "  " & version & suffix );
            if ( !release.prerelease ) latestShown = true;
        }
    }
}

function isValidVersion( version ) {
    return reFind( "^[A-Za-z0-9][A-Za-z0-9.+_-]*$", version ) == 1;
}

function getReleaseInfo( version ) {
    version = normalizeVersion( version );
    if ( !isValidVersion( version ) ) {
        println( "Invalid MatchBox version: " & version );
        cliexit( 1 );
    }
    var tag = version == "latest" ? "latest" : ( version == "snapshot" ? "snapshot" : "v" & version );
    var endpoint = tag == "latest" ? "/latest" : "/tags/" & tag;
    return githubJson( MATCHBOX_GITHUB_API & "/releases" & endpoint );
}

function findReleaseAsset( release, assetName ) {
    for ( asset in release.assets ) {
        if ( asset.name == assetName ) return asset.browser_download_url;
    }
    return "";
}

function installVersion( requestedVersion, force=false ) {
    var release = getReleaseInfo( len( trim( requestedVersion ) ) ? requestedVersion : "latest" );
    var version = normalizeVersion( release.tag_name );
    var versionDir = MVM_VERSIONS & "/" & version;
    if ( directoryExists( versionDir ) && !force ) {
        println( "MatchBox " & version & " is already installed. Use --force to reinstall." );
        return;
    }

    var assetName = getPlatformAssetName();
    var assetUrl = findReleaseAsset( release, assetName );
    if ( !len( assetUrl ) ) {
        println( "No " & assetName & " asset exists for MatchBox " & version );
        cliexit( 1 );
    }

    var downloadPath = MVM_CACHE & "/matchbox-" & version & "-" & createUUID() & ".download";
    println( "Downloading MatchBox " & version & "..." );
    var response = {};
    try {
        response = jsonDeserialize( http({
            url: assetUrl,
            path: downloadPath,
            timeout: 180
        }).get() );
    } catch ( any e ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        println( "failed." );
        println( e.message );
        cliexit( 1 );
    }
    if ( response.status != 200 || !fileExists( downloadPath ) || fileInfo( downloadPath ).size == 0 ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        println( "failed (HTTP " & response.status & ")." );
        cliexit( 1 );
    }

    var stageDir = MVM_VERSIONS & "/.mvm-stage-" & createUUID();
    var backupDir = MVM_VERSIONS & "/.mvm-backup-" & createUUID();
    var binaryName = isWindows() ? "matchbox.exe" : "matchbox";
    var stageBinary = stageDir & "/bin/" & binaryName;
    directoryCreate( stageDir & "/bin" );
    fileMove( downloadPath, stageBinary );
    if ( !isWindows() ) fileSetExecutable( stageBinary );

    var hadVersion = directoryExists( versionDir );
    if ( hadVersion ) directoryMove( versionDir, backupDir );
    try {
        directoryMove( stageDir, versionDir );
    } catch ( any e ) {
        if ( hadVersion ) directoryMove( backupDir, versionDir );
        if ( directoryExists( stageDir ) ) directoryDelete( stageDir, true );
        println( "Could not install MatchBox " & version & ": " & e.message );
        cliexit( 1 );
    }
    if ( hadVersion ) directoryDelete( backupDir, true );
    println( "MatchBox " & version & " installed." );
}

function useVersion( version ) {
    version = trim( version );
    if ( !len( version ) && fileExists( ".mvmrc" ) ) {
        version = trim( fileRead( ".mvmrc" ) );
    }
    if ( !isValidVersion( version ) ) {
        println( "Specify a valid MatchBox version or set .mvmrc." );
        cliexit( 1 );
    }

    var versionDir = MVM_VERSIONS & "/" & version;
    if ( !directoryExists( versionDir ) ) {
        println( "MatchBox " & version & " is not installed. Run: mvm install " & version );
        cliexit( 1 );
    }

    fileWrite( MVM_CURRENT, version & chr( 10 ) );
    println( "Now using MatchBox " & version );
}

function listInstalledVersions() {
    var installed = directoryList( MVM_VERSIONS, false, "name" );
    if ( !arrayLen( installed ) ) {
        println( "No MatchBox versions installed. Run 'mvm install latest' to get started." );
        return;
    }
    for ( version in installed ) println( version );
}

function showLocalVersion() {
    if ( !fileExists( ".mvmrc" ) ) {
        println( "No local MatchBox version is set." );
        return;
    }
    println( "Local MatchBox version: " & trim( fileRead( ".mvmrc" ) ) );
}

function showCurrent() {
    if ( !fileExists( MVM_CURRENT ) ) {
        println( "No MatchBox version is active. Run 'mvm use <version>'." );
        return;
    }
    println( "Current MatchBox version: " & trim( fileRead( MVM_CURRENT ) ) );
}

function showHelp() {
    println( "📦 MatchBox Version Manager (MVM) v" & MVM_VERSION );
    println( "" );
    println( "USAGE: mvm <command> [arguments]" );
    println( "" );
    println( "  install <version>     Install a MatchBox version" );
    println( "  use [version]         Activate a version or read .mvmrc" );
    println( "  local [version]       Set or show the current directory's .mvmrc" );
    println( "  current               Show the active MatchBox version" );
    println( "  list                  List installed versions" );
    println( "  list-remote           List versions available to install" );
    println( "  remove <version>      Remove an installed version" );
    println( "  exec <args...>        Run MatchBox with the active version" );
    println( "  run <args...>         Alias for exec" );
    println( "  tui                   Browse, install, and activate versions" );
    println( "  version               Show MVM version" );
    println( "  help                  Show this help" );
    println( "" );
    println( "MVM_HOME defaults to ~/.mvm" );
}

var cli = cligetargs();
var args = cli.positionals;
var command = arrayLen( args ) ? trim( args[ 1 ] ) : "";

switch ( command ) {
    case "":
    case "help":
    case "--help":
    case "-h":
        showHelp();
        break;
    case "use":
        useVersion( arrayLen( args ) >= 2 ? args[ 2 ] : "" );
        break;
    case "local":
        if ( arrayLen( args ) < 2 || !len( trim( args[ 2 ] ) ) ) {
            showLocalVersion();
        } else {
            fileWrite( ".mvmrc", trim( args[ 2 ] ) & chr( 10 ) );
            println( "Local MatchBox version set to " & trim( args[ 2 ] ) );
        }
        break;
    case "current":
        showCurrent();
        break;
    case "install":
        var force = cli.options.keyExists( "force" ) && cli.options.force;
        installVersion( arrayLen( args ) >= 2 ? args[ 2 ] : "latest", force );
        break;
    case "list-remote":
        listRemoteVersions();
        break;
    case "version":
        println( "MVM version: " & MVM_VERSION );
        break;
    case "list":
    case "ls":
        listInstalledVersions();
        break;
    default:
        println( "MVM" );
}
