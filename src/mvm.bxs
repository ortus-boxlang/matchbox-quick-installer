MVM_VERSION = "0.1.4";
MVM_HOME = getsystemsetting( "MVM_HOME", getsystemsetting( "HOME", getsystemsetting( "USERPROFILE", "~" ) ) & "/.mvm" );
MVM_VERSIONS = MVM_HOME & "/versions";
MVM_CACHE = MVM_HOME & "/cache";
MVM_CURRENT = MVM_HOME & "/current";
MATCHBOX_GITHUB_API = "https://api.github.com/repos/ortus-boxlang/matchbox";
MVM_GITHUB_API = "https://api.github.com/repos/ortus-boxlang/matchbox-quick-installer";
MVM_UPDATE_CHECK = MVM_HOME & "/update-check";

if ( !directoryExists( MVM_HOME ) ) directoryCreate( MVM_HOME );
if ( !directoryExists( MVM_VERSIONS ) ) directoryCreate( MVM_VERSIONS );
if ( !directoryExists( MVM_CACHE ) ) directoryCreate( MVM_CACHE );

function githubJson( url, failFast=true, timeout=30 ) {
    var response = {};
    try {
        response = jsonDeserialize( http({
            url: url,
            headers: { "User-Agent": "MVM" },
            timeout: timeout
        }).get() );
    } catch ( any e ) {
        if ( !failFast ) return {};
        println( "Could not contact GitHub: " & e.message );
        cliexit( 1 );
    }
    if ( response.status != 200 ) {
        if ( !failFast ) return {};
        println( "GitHub request failed with HTTP " & response.status );
        cliexit( 1 );
    }
    try {
        return jsonDeserialize( response.body );
    } catch ( any e ) {
        if ( !failFast ) return {};
        println( "Invalid GitHub response: " & e.message );
        cliexit( 1 );
    }
}

function isWindows() {
    return getsystemsetting( "OS", "" ).lCase() contains "windows";
}

function getPlatformAssetName( prefix="matchbox" ) {
    var windows = isWindows();
    var os = "";
    if ( windows ) {
        os = "windows";
    } else {
        var osResult = systemExecute( "uname", [ "-s" ], 10 );
        var osName = trim( osResult.output ).lCase();
        if ( osName contains "linux" ) os = "linux";
        if ( osName contains "darwin" ) os = "macos";
        if ( !len( os ) ) {
            println( "Unsupported operating system: " & osName );
            cliexit( 1 );
        }
    }

    var arch = windows
        ? getsystemsetting( "PROCESSOR_ARCHITECTURE", "x64" ).lCase()
        : trim( systemExecute( "uname", [ "-m" ], 10 ).output ).lCase();
    if ( arch == "x86_64" || arch == "amd64" || arch == "x64" ) arch = "x64";
    else if ( arch == "aarch64" || arch == "arm64" ) arch = "arm64";
    else if ( arch == "i386" || arch == "i686" || arch == "x86" ) arch = "x86";
    else if ( arch.startsWith( "armv7" ) ) arch = "armv7";
    else {
        println( "Unsupported architecture: " & arch );
        cliexit( 1 );
    }
    return prefix & "-" & os & "-" & arch & ( windows ? ".exe" : "" );
}

function normalizeVersion( version ) {
    version = trim( version );
    return version.startsWith( "v" ) ? listLast( version, "v" ) : version;
}

function getRemoteReleases() {
    var releases = githubJson( MATCHBOX_GITHUB_API & "/releases?per_page=100" );
    var assetName = getPlatformAssetName();
    var available = [];
    for ( release in releases ) {
        if ( !isValidVersion( normalizeVersion( release.tag_name ) ) ) continue;
        if ( len( findReleaseAsset( release, assetName ) ) ) arrayAppend( available, release );
    }
    return available;
}

function listRemoteVersions() {
    var releases = getRemoteReleases();
    println( "Available MatchBox versions:" );
    var latestShown = false;
    for ( release in releases ) {
        var version = normalizeVersion( release.tag_name );
        var suffix = release.prerelease ? " (pre-release)" : ( !latestShown ? " (latest)" : "" );
        println( "  " & version & suffix );
        if ( !release.prerelease ) latestShown = true;
    }
}

function isValidVersion( version ) {
    return reFind( "^[A-Za-z0-9][A-Za-z0-9.+_-]*$", version ) == 1;
}

function compareVersions( left, right ) {
    var leftParts = listToArray( listFirst( left, "-" ), "." );
    var rightParts = listToArray( listFirst( right, "-" ), "." );
    for ( var i = 1; i <= 3; i++ ) {
        var leftPart = i <= arrayLen( leftParts ) ? val( leftParts[ i ] ) : 0;
        var rightPart = i <= arrayLen( rightParts ) ? val( rightParts[ i ] ) : 0;
        if ( leftPart > rightPart ) return 1;
        if ( leftPart < rightPart ) return -1;
    }
    var leftPrerelease = find( "-", left ) > 0;
    var rightPrerelease = find( "-", right ) > 0;
    if ( leftPrerelease && !rightPrerelease ) return -1;
    if ( !leftPrerelease && rightPrerelease ) return 1;
    return 0;
}

function getInstalledMvmVersion( binaryPath ) {
    if ( !fileExists( binaryPath ) ) return "";
    try {
        var result = systemExecute( binaryPath, [ "version" ], 10 );
        var versions = reMatchNoCase( "[0-9]+[.][0-9]+[.][0-9]+(-[A-Za-z0-9.-]+)?", result.output & result.error );
        return result.exitCode == 0 && arrayLen( versions ) ? versions[ 1 ] : "";
    } catch ( any e ) {
        return "";
    }
}

function getReleaseInfo( version ) {
    version = normalizeVersion( version );
    if ( !isValidVersion( version ) ) {
        println( "Invalid MatchBox version: " & version );
        cliexit( 1 );
    }
    var tag = version == "latest" ? "latest" : ( version == "snapshot" ? "snapshot" : "v" & version );
    var endpoint = tag == "latest" ? "/latest" : "/tags/" & tag;
    return githubJson( MATCHBOX_GITHUB_API & "/releases" & endpoint );
}

function findReleaseAsset( release, assetName ) {
    for ( asset in release.assets ) {
        if ( asset.name == assetName ) return asset.browser_download_url;
    }
    return "";
}

function installVersion( requestedVersion, force=false ) {
    var release = getReleaseInfo( len( trim( requestedVersion ) ) ? requestedVersion : "latest" );
    var version = normalizeVersion( release.tag_name );
    if ( !isValidVersion( version ) ) {
        println( "GitHub returned an invalid MatchBox version: " & version );
        cliexit( 1 );
    }
    var versionDir = MVM_VERSIONS & "/" & version;
    if ( directoryExists( versionDir ) && !force ) {
        println( "MatchBox " & version & " is already installed. Use --force to reinstall." );
        return version;
    }

    var assetName = getPlatformAssetName();
    var assetUrl = findReleaseAsset( release, assetName );
    if ( !len( assetUrl ) ) {
        println( "No " & assetName & " asset exists for MatchBox " & version );
        cliexit( 1 );
    }

    var downloadPath = MVM_CACHE & "/matchbox-" & version & "-" & createUUID() & ".download";
    println( "Downloading MatchBox " & version & "..." );
    var response = {};
    try {
        response = jsonDeserialize( http({
            url: assetUrl,
            path: downloadPath,
            timeout: 180
        }).get() );
    } catch ( any e ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        println( "failed." );
        println( e.message );
        cliexit( 1 );
    }
    if ( response.status != 200 || !fileExists( downloadPath ) || fileInfo( downloadPath ).size == 0 ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        println( "failed (HTTP " & response.status & ")." );
        cliexit( 1 );
    }

    var stageDir = MVM_VERSIONS & "/.mvm-stage-" & createUUID();
    var backupDir = MVM_VERSIONS & "/.mvm-backup-" & createUUID();
    var binaryName = isWindows() ? "matchbox.exe" : "matchbox";
    var stageBinary = stageDir & "/bin/" & binaryName;
    directoryCreate( stageDir & "/bin" );
    fileMove( downloadPath, stageBinary );
    if ( !isWindows() ) fileSetExecutable( stageBinary );

    var hadVersion = directoryExists( versionDir );
    if ( hadVersion ) directoryMove( versionDir, backupDir );
    try {
        directoryMove( stageDir, versionDir );
    } catch ( any e ) {
        if ( hadVersion ) directoryMove( backupDir, versionDir );
        if ( directoryExists( stageDir ) ) directoryDelete( stageDir, true );
        println( "Could not install MatchBox " & version & ": " & e.message );
        cliexit( 1 );
    }
    if ( hadVersion ) directoryDelete( backupDir, true );
    println( "MatchBox " & version & " installed." );
    return version;
}

function getCurrentVersion() {
    if ( !fileExists( MVM_CURRENT ) ) return "";
    var version = normalizeVersion( trim( fileRead( MVM_CURRENT ) ) );
    return isValidVersion( version ) ? version : "";
}

function createMatchboxShim() {
    var binDirectory = MVM_HOME & "/bin";
    if ( !directoryExists( binDirectory ) ) directoryCreate( binDirectory );

    if ( isWindows() ) {
        fileWrite(
            binDirectory & "/matchbox.cmd",
            "@echo off" & chr( 13 ) & chr( 10 ) &
            "set /p MVM_VERSION=<" & chr( 34 ) & "%~dp0..\current" & chr( 34 ) & chr( 13 ) & chr( 10 ) &
            chr( 34 ) & "%~dp0..\versions\%MVM_VERSION%\bin\matchbox.exe" & chr( 34 ) & " %*" & chr( 13 ) & chr( 10 )
        );
        return;
    }

    fileWrite(
        binDirectory & "/matchbox",
        '#!/bin/sh' & chr( 10 ) &
        'MVM_HOME=$(cd "$(dirname "$0")/.." && pwd)' & chr( 10 ) &
        'VERSION=$(cat "$MVM_HOME/current") || exit 1' & chr( 10 ) &
        'exec "$MVM_HOME/versions/$VERSION/bin/matchbox" "$@"' & chr( 10 )
    );
    fileSetExecutable( binDirectory & "/matchbox" );
}

function useVersion( version ) {
    version = trim( version );
    if ( !len( version ) && fileExists( ".mvmrc" ) ) {
        version = trim( fileRead( ".mvmrc" ) );
    }
    version = normalizeVersion( version );
    if ( version == "latest" || version == "snapshot" ) {
        version = normalizeVersion( getReleaseInfo( version ).tag_name );
    }
    if ( !isValidVersion( version ) ) {
        println( "Specify a valid MatchBox version or set .mvmrc." );
        cliexit( 1 );
    }

    var versionDir = MVM_VERSIONS & "/" & version;
    if ( !directoryExists( versionDir ) ) {
        println( "MatchBox " & version & " is not installed. Run: mvm install " & version );
        cliexit( 1 );
    }

    fileWrite( MVM_CURRENT, version & chr( 10 ) );
    createMatchboxShim();
    println( "Now using MatchBox " & version );
}

function updateFailure( message, failFast ) {
    println( "MVM update failed: " & message );
    if ( failFast ) cliexit( 1 );
    return false;
}

function replaceMvmOnUnix( downloadPath, binaryPath ) {
    var backupPath = binaryPath & ".previous";
    if ( fileExists( backupPath ) ) {
        try {
            fileDelete( backupPath );
        } catch ( any e ) {
            return e.message;
        }
    }
    try {
        fileMove( binaryPath, backupPath );
        fileMove( downloadPath, binaryPath );
        fileSetExecutable( binaryPath );
    } catch ( any e ) {
        if ( fileExists( backupPath ) ) {
            if ( fileExists( binaryPath ) ) fileDelete( binaryPath );
            fileMove( backupPath, binaryPath );
        }
        return e.message;
    }
    try {
        if ( fileExists( backupPath ) ) fileDelete( backupPath );
    } catch ( any e ) {}
    return "";
}

function scheduleMvmUpdateOnWindows( downloadPath, binDirectory ) {
    var pendingPath = binDirectory & "/mvm-update.exe";
    var scriptPath = binDirectory & "/mvm-update.cmd";
    var quote = chr( 34 );
    var newline = chr( 13 ) & chr( 10 );
    try {
        if ( fileExists( pendingPath ) ) fileDelete( pendingPath );
        if ( fileExists( scriptPath ) ) fileDelete( scriptPath );
        fileMove( downloadPath, pendingPath );
        fileWrite( scriptPath,
            "@echo off" & newline &
            "set /a tries=0" & newline &
            ":retry" & newline &
            "move /y " & quote & "%~dp0mvm-update.exe" & quote & " " & quote & "%~dp0mvm.exe" & quote & " >nul 2>&1" & newline &
            "if not errorlevel 1 goto done" & newline &
            "set /a tries+=1" & newline &
            "if %tries% geq 30 goto failed" & newline &
            "timeout /t 1 /nobreak >nul" & newline &
            "goto retry" & newline &
            ":done" & newline &
            "del " & quote & "%~f0" & quote & " >nul 2>&1" & newline &
            "exit /b 0" & newline &
            ":failed" & newline &
            "echo MVM update failed. Run the installer again." & newline &
            "del " & quote & "%~dp0mvm-update.exe" & quote & " >nul 2>&1" & newline &
            "exit /b 1" & newline
        );
        var launch = systemExecute(
            "cmd",
            [ "/c", "start " & quote & quote & " /b " & quote & scriptPath & quote & " >nul 2>&1" ],
            10
        );
        return launch.exitCode == 0 ? "" : "Could not start the Windows updater.";
    } catch ( any e ) {
        return e.message;
    }
}

function updateMvmExecutable( release, failFast=true ) {
    var version = normalizeVersion( release.tag_name ?: "" );
    if ( !isValidVersion( version ) ) return updateFailure( "GitHub returned an invalid MVM version.", failFast );

    var binDirectory = MVM_HOME & "/bin";
    var binaryPath = binDirectory & "/mvm" & ( isWindows() ? ".exe" : "" );
    if ( !fileExists( binaryPath ) ) {
        return updateFailure( "MVM executable not found at " & binaryPath & ". Re-run the installer.", failFast );
    }
    var installedVersion = getInstalledMvmVersion( binaryPath );
    if ( len( installedVersion ) && compareVersions( installedVersion, version ) >= 0 ) {
        println( "MVM is already up to date (" & installedVersion & ")." );
        return true;
    }

    var assetUrl = findReleaseAsset( release, getPlatformAssetName( "mvm" ) );
    if ( !len( assetUrl ) ) return updateFailure( "No MVM binary exists for this platform.", failFast );
    var downloadPath = MVM_CACHE & "/mvm-" & version & "-" & createUUID() & ".download";
    println( "Downloading MVM " & version & "..." );
    var response = {};
    try {
        response = jsonDeserialize( http({ url: assetUrl, path: downloadPath, timeout: 180 }).get() );
    } catch ( any e ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        return updateFailure( e.message, failFast );
    }
    if ( response.status != 200 || !fileExists( downloadPath ) || fileInfo( downloadPath ).size == 0 ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        return updateFailure( "Download failed (HTTP " & response.status & ").", failFast );
    }

    var error = isWindows()
        ? scheduleMvmUpdateOnWindows( downloadPath, binDirectory )
        : replaceMvmOnUnix( downloadPath, binaryPath );
    if ( len( error ) ) {
        if ( fileExists( downloadPath ) ) fileDelete( downloadPath );
        return updateFailure( error, failFast );
    }
    println( isWindows() ? "MVM " & version & " update will finish after this command exits." : "Updated MVM to " & version & "." );
    return true;
}

function updateMvmCommand() {
    updateMvmExecutable( githubJson( MVM_GITHUB_API & "/releases/latest" ) );
}

function checkMvmUpdateOnStartup( command ) {
    if ( !cliIsTerminal() || listFindNoCase( "help,--help,-h,version,update,completion", command ) ) return;
    var binaryPath = MVM_HOME & "/bin/mvm" & ( isWindows() ? ".exe" : "" );
    if ( !fileExists( binaryPath ) ) return;
    var nowMillis = now().getTime();
    if ( fileExists( MVM_UPDATE_CHECK ) ) {
        try {
            var lastCheck = val( trim( fileRead( MVM_UPDATE_CHECK ) ) );
            if ( lastCheck > 0 && nowMillis >= lastCheck && nowMillis - lastCheck < 86400000 ) return;
        } catch ( any e ) {}
    }
    try {
        fileWrite( MVM_UPDATE_CHECK, nowMillis & chr( 10 ) );
    } catch ( any e ) {
        return;
    }

    var release = githubJson( MVM_GITHUB_API & "/releases/latest", false, 5 );
    if ( !release.keyExists( "tag_name" ) ) return;
    var latestVersion = normalizeVersion( release.tag_name );
    var installedVersion = getInstalledMvmVersion( binaryPath );
    var currentVersion = len( installedVersion ) ? installedVersion : MVM_VERSION;
    if ( !isValidVersion( latestVersion ) || compareVersions( latestVersion, currentVersion ) <= 0 ) return;
    if ( !len( findReleaseAsset( release, getPlatformAssetName( "mvm" ) ) ) ) return;

    var answer = "";
    try {
        answer = trim( cliread( "MVM " & latestVersion & " is available. Update now? [y/N] " ) ).lCase();
    } catch ( any e ) {
        return;
    }
    if ( answer == "y" || answer == "yes" ) updateMvmExecutable( release, false );
}

function showTui() {
    if ( !cliIsTerminal() ) {
        println( "The MVM TUI requires an interactive terminal. Use 'mvm list-remote' instead." );
        return;
    }

    var releases = getRemoteReleases();
    var installed = directoryList( MVM_VERSIONS, false, "name" );
    var current = getCurrentVersion();
    var choices = [];
    for ( release in releases ) {
        var version = normalizeVersion( release.tag_name );
        var status = version == current ? "current" : ( directoryExists( MVM_VERSIONS & "/" & version ) ? "installed" : "available" );
        arrayAppend( choices, version & " (" & status & ")" );
    }
    for ( version in installed ) {
        var found = false;
        for ( release in releases ) {
            if ( normalizeVersion( release.tag_name ) == normalizeVersion( version ) ) found = true;
        }
        if ( !found ) arrayAppend( choices, normalizeVersion( version ) & " (installed)" );
    }
    if ( !arrayLen( choices ) ) {
        println( "No MatchBox versions are available for this platform." );
        return;
    }

    var selected = cliselect( "Select a MatchBox version", choices );
    if ( !len( selected ) ) return;
    var selectedVersion = listFirst( selected, " " );
    if ( !directoryExists( MVM_VERSIONS & "/" & selectedVersion ) ) installVersion( selectedVersion );
    useVersion( selectedVersion );
}

function removeVersion( version ) {
    version = normalizeVersion( trim( version ) );
    if ( !isValidVersion( version ) ) {
        println( "Specify a valid MatchBox version to remove." );
        cliexit( 1 );
    }
    var versionDir = MVM_VERSIONS & "/" & version;
    if ( !directoryExists( versionDir ) ) {
        println( "MatchBox " & version & " is not installed." );
        return;
    }
    if ( getCurrentVersion() == version && fileExists( MVM_CURRENT ) ) fileDelete( MVM_CURRENT );
    directoryDelete( versionDir, true );
    println( "MatchBox " & version & " removed." );
}

function listInstalledVersions() {
    var installed = directoryList( MVM_VERSIONS, false, "name" );
    if ( !arrayLen( installed ) ) {
        println( "No MatchBox versions installed. Run 'mvm install latest' to get started." );
        return;
    }
    var current = getCurrentVersion();
    for ( version in installed ) {
        var displayVersion = normalizeVersion( version );
        println( displayVersion == current ? "▶ " & displayVersion & " (current)" : "  " & displayVersion );
    }
}

function showLocalVersion() {
    if ( !fileExists( ".mvmrc" ) ) {
        println( "No local MatchBox version is set." );
        return;
    }
    println( "Local MatchBox version: " & trim( fileRead( ".mvmrc" ) ) );
}

function showCurrent() {
    var current = getCurrentVersion();
    if ( !len( current ) ) {
        println( "No MatchBox version is active. Run 'mvm use <version>'." );
        return;
    }
    println( "Current MatchBox version: " & current );
}

function cleanCache() {
    if ( directoryExists( MVM_CACHE ) ) directoryDelete( MVM_CACHE, true );
    directoryCreate( MVM_CACHE );
    println( "MVM download cache cleared." );
}

function bashCompletionStatus( fix=false ) {
    var shellPath = getsystemsetting( "SHELL", "" );
    var shellName = listLast( replace( shellPath, chr( 92 ), "/", "all" ), "/" ).lCase();
    if ( isWindows() || shellName != "bash" ) return { supported: false, configured: false };

    var osName = trim( systemExecute( "uname", [ "-s" ], 10 ).output ).lCase();
    if ( osName != "linux" && osName != "darwin" ) return { supported: false, configured: false };

    var home = getsystemsetting( "HOME", getsystemsetting( "USERPROFILE", "" ) );
    if ( !len( trim( home ) ) ) return { supported: false, configured: false };
    var profile = home & "/.bashrc";
    var loginReady = osName != "darwin";
    if ( osName == "darwin" ) {
        var loginProfile = home & "/.bash_profile";
        var loginContents = fileExists( loginProfile ) ? fileRead( loginProfile ) : "";
        var bridgeMarker = "MVM Bash login bridge";
        var bridged = findNoCase( bridgeMarker, loginContents ) > 0 && findNoCase( ".bashrc", loginContents ) > 0;
        if ( fileExists( loginProfile ) && !bridged ) {
            profile = loginProfile;
            loginReady = true;
        } else {
            if ( fix && !bridged ) {
                var bridgeLines = [];
                if ( findNoCase( bridgeMarker, loginContents ) == 0 ) arrayAppend( bridgeLines, chr( 35 ) & " " & bridgeMarker );
                if ( fileExists( home & "/.bash_login" ) && findNoCase( ".bash_login", loginContents ) == 0 ) {
                    arrayAppend( bridgeLines, '[ -r "$HOME/.bash_login" ] && . "$HOME/.bash_login"' );
                } else if ( fileExists( home & "/.profile" ) && findNoCase( ".profile", loginContents ) == 0 ) {
                    arrayAppend( bridgeLines, '[ -r "$HOME/.profile" ] && . "$HOME/.profile"' );
                }
                var bashrcLine = '[ -r "$HOME/.bashrc" ] && . "$HOME/.bashrc"';
                if ( findNoCase( bashrcLine, loginContents ) == 0 ) arrayAppend( bridgeLines, bashrcLine );
                fileWrite( loginProfile, ( len( loginContents ) ? loginContents & chr( 10 ) : "" ) & arrayToList( bridgeLines, chr( 10 ) ) & chr( 10 ) );
                bridged = true;
            }
            profile = home & "/.bashrc";
            loginReady = bridged;
        }
    }

    var completionFile = MVM_HOME & "/completions/mvm.bash";
    var profileContents = fileExists( profile ) ? fileRead( profile ) : "";
    var quotedPath = "'" & replace( completionFile, "'", "'" & chr( 92 ) & "''", "all" ) & "'";
    var registrationMarker = "MVM bash completion " & quotedPath;
    var sourceLine = "[ -r " & quotedPath & " ] && . " & quotedPath;
    var registered = findNoCase( "MVM_HOME/completions/mvm.bash", profileContents ) > 0 || findNoCase( sourceLine, profileContents ) > 0;
    var current = fileExists( completionFile ) && trim( fileRead( completionFile ) ) == trim( getBashCompletionScript() );
    if ( fix ) {
        var completionDirectory = MVM_HOME & "/completions";
        if ( !directoryExists( completionDirectory ) ) directoryCreate( completionDirectory );
        fileWrite( completionFile, getBashCompletionScript() );
        if ( !registered ) {
            var markerLine = findNoCase( registrationMarker, profileContents ) > 0 ? "" : chr( 35 ) & " " & registrationMarker & chr( 10 );
            fileWrite( profile, ( len( profileContents ) ? profileContents & chr( 10 ) : "" ) & markerLine & sourceLine & chr( 10 ) );
        }
        registered = true;
        current = true;
    }
    return { supported: true, configured: current && registered && loginReady, profile: profile, completionFile: completionFile };
}

function doctor( fixBashCompletions=false ) {
    var bashCompletions = {};
    try {
        bashCompletions = bashCompletionStatus( fixBashCompletions );
    } catch ( any e ) {
        println( "Could not inspect or repair Bash completions: " & e.message );
        cliexit( 1 );
    }
    if ( fixBashCompletions && !bashCompletions.supported ) {
        println( "Bash completion repair requires Bash on Linux or macOS." );
        cliexit( 1 );
    }
    if ( bashCompletions.supported ) {
        if ( fixBashCompletions ) println( "Bash completions installed at " & bashCompletions.completionFile & ". Restart your shell or source " & bashCompletions.profile & "." );
        else if ( !bashCompletions.configured ) println( "Bash completions are missing or stale. Run 'mvm doctor --fix'." );
        else println( "Bash completions are configured." );
    }

    var windows = isWindows();
    var binDirectory = MVM_HOME & "/bin";
    var expectedBin = binDirectory;
    if ( windows ) expectedBin = replace( expectedBin, "/", chr( 92 ), "all" ).lCase();
    var path = getsystemsetting( "PATH", "" );
    var pathEntries = listToArray( path, windows ? ";" : ":" );
    var binOnPath = false;
    for ( pathEntry in pathEntries ) {
        pathEntry = trim( pathEntry );
        if ( windows ) pathEntry = replace( pathEntry, "/", chr( 92 ), "all" ).lCase();
        if ( pathEntry == expectedBin ) binOnPath = true;
    }

    println( "MVM version: " & MVM_VERSION );
    println( "MVM_HOME: " & MVM_HOME );
    if ( !binOnPath ) {
        println( "MVM bin directory is not on PATH: " & binDirectory );
        cliexit( 1 );
    }

    if ( !fileExists( MVM_CURRENT ) ) {
        println( "No MatchBox version is active. Run 'mvm use latest'." );
        println( "MVM is healthy." );
        return;
    }

    var current = getCurrentVersion();
    if ( !len( current ) ) {
        println( "Invalid active version marker: " & MVM_CURRENT );
        cliexit( 1 );
    }
    var binaryName = windows ? "matchbox.exe" : "matchbox";
    var binaryPath = MVM_VERSIONS & "/" & current & "/bin/" & binaryName;
    if ( !fileExists( binaryPath ) ) {
        println( "Active MatchBox binary is missing: " & binaryPath );
        cliexit( 1 );
    }
    var shimPath = binDirectory & "/matchbox" & ( windows ? ".cmd" : "" );
    if ( !fileExists( shimPath ) ) {
        println( "MatchBox command shim is missing. Run 'mvm use " & current & "'." );
        cliexit( 1 );
    }
    println( "Active MatchBox: " & current );
    println( "matchbox command is available." );
    println( "MVM is healthy." );
}

function getForwardedArgs( positionals ) {
    var forwarded = [];
    for ( var i = 2; i <= arrayLen( positionals ); i++ ) arrayAppend( forwarded, positionals[ i ] );
    return forwarded;
}

function execCurrentVersion( execArguments, cliOptions ) {
    var current = getCurrentVersion();
    if ( !len( current ) ) {
        println( "No MatchBox version is active. Run 'mvm use <version>'." );
        cliexit( 1 );
    }
    var binaryName = isWindows() ? "matchbox.exe" : "matchbox";
    var binaryPath = MVM_VERSIONS & "/" & current & "/bin/" & binaryName;
    if ( !fileExists( binaryPath ) ) {
        println( "MatchBox binary not found: " & binaryPath );
        cliexit( 1 );
    }
    for ( option in cliOptions ) {
        var optionValue = cliOptions[ option ];
        arrayAppend( execArguments, optionValue == false ? "--no-" & option : "--" & option & ( optionValue == true ? "" : "=" & optionValue ) );
    }
    var result = {};
    try {
        result = systemExecute( binaryPath, execArguments, 0, false, null, null, null, true, {}, true );
    } catch ( any e ) {
        println( "Could not execute MatchBox: " & e.message );
        cliexit( 1 );
    }
    if ( isNull( result.exitCode ) || result.exitCode != 0 ) cliexit( isNull( result.exitCode ) ? 1 : result.exitCode );
}

function getBashCompletionScript() {
    var quote = chr( 34 );
    var lines = [];
    arrayAppend( lines, "_mvm_completions() {" );
    arrayAppend( lines, "  local cur=${COMP_WORDS[COMP_CWORD]}" );
    arrayAppend( lines, "  local command=${COMP_WORDS[1]}" );
    arrayAppend( lines, "  local version" );
    arrayAppend( lines, "  if [[ $COMP_CWORD == 1 ]]; then" );
    arrayAppend( lines, "    COMPREPLY=( $(compgen -W 'install update use local current doctor clean list ls list-remote remove uninstall exec run tui version completion help' -- " & quote & "$cur" & quote & ") )" );
    arrayAppend( lines, "    return" );
    arrayAppend( lines, "  fi" );
    arrayAppend( lines, "  [[ $COMP_CWORD == 2 ]] || return" );
    arrayAppend( lines, "  case $command in" );
    arrayAppend( lines, "    install)" );
    arrayAppend( lines, "      if [[ $cur == -* ]]; then" );
    arrayAppend( lines, "        COMPREPLY=( $(compgen -W '--force' -- " & quote & "$cur" & quote & ") )" );
    arrayAppend( lines, "      else" );
    arrayAppend( lines, "        COMPREPLY=( $(compgen -W 'latest' -- " & quote & "$cur" & quote & ") )" );
    arrayAppend( lines, "      fi" );
    arrayAppend( lines, "      ;;" );
    arrayAppend( lines, "    use|local|remove)" );
    arrayAppend( lines, "      local -a versions=()" );
    arrayAppend( lines, "      for version in " & quote & "${MVM_HOME:-$HOME/.mvm}/versions/" & quote & "*; do" );
    arrayAppend( lines, "        [[ -d $version ]] && versions+=( " & quote & "${version" & chr( 35 ) & chr( 35 ) & "*/}" & quote & " )" );
    arrayAppend( lines, "      done" );
    arrayAppend( lines, "      COMPREPLY=( $(compgen -W " & quote & "${versions[*]}" & quote & " -- " & quote & "$cur" & quote & ") )" );
    arrayAppend( lines, "      ;;" );
    arrayAppend( lines, "    doctor) COMPREPLY=( $(compgen -W '--fix' -- " & quote & "$cur" & quote & ") ) ;;" );
    arrayAppend( lines, "    completion) COMPREPLY=( $(compgen -W 'bash' -- " & quote & "$cur" & quote & ") ) ;;" );
    arrayAppend( lines, "  esac" );
    arrayAppend( lines, "}" );
    arrayAppend( lines, "if [[ $- == *i* ]]; then" );
    arrayAppend( lines, "  complete -o default -F _mvm_completions mvm" );
    arrayAppend( lines, "fi" );
    return arrayToList( lines, chr( 10 ) ) & chr( 10 );
}

function showBashCompletion() {
    print( getBashCompletionScript() );
}

function showHelp() {
    println( "📦 MatchBox Version Manager (MVM) v" & MVM_VERSION );
    println( "" );
    println( "USAGE: mvm <command> [arguments]" );
    println( "" );
    println( "  install <version>     Install a MatchBox version" );
    println( "  update                Update the MVM executable" );
    println( "  use [version]         Activate a version or read .mvmrc" );
    println( "  local [version]       Set or show the current directory's .mvmrc" );
    println( "  current               Show the active MatchBox version" );
    println( "  doctor [--fix]        Check MVM; --fix repairs Bash completions" );
    println( "  clean                 Clear temporary download files" );
    println( "  list                  List installed versions" );
    println( "  list-remote           List versions available to install" );
    println( "  remove <version>      Remove an installed version" );
    println( "  exec <args...>        Run MatchBox with the active version" );
    println( "  run <args...>         Alias for exec" );
    println( "  tui                   Browse, install, and activate versions" );
    println( "  version               Show MVM version" );
    println( "  completion bash       Print Bash completion script" );
    println( "  help                  Show this help" );
    println( "" );
    println( "  install <version> --force  Reinstall an existing version" );
    println( "" );
    println( "MVM_HOME defaults to ~/.mvm" );
}

var cli = cligetargs();
var args = cli.positionals;
var command = arrayLen( args ) ? trim( args[ 1 ] ) : "";

checkMvmUpdateOnStartup( command );

switch ( command ) {
    case "":
    case "help":
    case "--help":
    case "-h":
        showHelp();
        break;
    case "use":
        useVersion( arrayLen( args ) >= 2 ? args[ 2 ] : "" );
        break;
    case "local":
        if ( arrayLen( args ) < 2 || !len( trim( args[ 2 ] ) ) ) {
            showLocalVersion();
        } else {
            fileWrite( ".mvmrc", trim( args[ 2 ] ) & chr( 10 ) );
            println( "Local MatchBox version set to " & trim( args[ 2 ] ) );
        }
        break;
    case "current":
        showCurrent();
        break;
    case "doctor":
        doctor( cli.options.keyExists( "fix" ) && cli.options.fix );
        break;
    case "clean":
        cleanCache();
        break;
    case "install":
        installVersion( arrayLen( args ) >= 2 ? args[ 2 ] : "latest", cli.options.keyExists( "force" ) && cli.options.force );
        break;
    case "update":
        updateMvmCommand();
        break;
    case "exec":
    case "run":
        execCurrentVersion( getForwardedArgs( args ), cli.options );
        break;
    case "remove":
    case "uninstall":
        removeVersion( arrayLen( args ) >= 2 ? args[ 2 ] : "" );
        break;
    case "tui":
        showTui();
        break;
    case "list-remote":
        listRemoteVersions();
        break;
    case "version":
        println( "MVM version: " & MVM_VERSION );
        break;
    case "completion":
        if ( arrayLen( args ) < 2 || args[ 2 ].lCase() != "bash" ) {
            println( "Usage: mvm completion bash" );
            cliexit( 1 );
        }
        showBashCompletion();
        break;
    case "list":
    case "ls":
        listInstalledVersions();
        break;
    default:
        println( "Unknown command: " & command & ". Run 'mvm help' for usage." );
        cliexit( 1 );
}
